{
  "description": "dev-flow: block an edit of an approved acceptance test (.dev-flow/spec-lock.json), and each direct access to the held-back tests.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Read|Grep|Glob|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
