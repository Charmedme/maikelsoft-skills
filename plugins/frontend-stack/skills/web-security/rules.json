{
  "skill": "web-security",
  "rules": [
    {
      "id": "SC-TS-TOKEN-STORAGE",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.ts",
        "**/*.js"
      ],
      "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.min.js",
        "**/node_modules/**",
        "e2e/**",
        "**/e2e/**"
      ],
      "pattern": "(?i)\\b(localStorage|sessionStorage)\\.setItem\\s*\\([^)\\n]*(token|jwt|bearer|session|auth|credential|password)",
      "message": "Each XSS can read localStorage and sessionStorage, and with them the token (OWASP HTML5).",
      "fix": "Use a BFF with an HttpOnly cookie (SEC-03). If the app must hold a token, keep it in memory only.",
      "match": [
        "localStorage.setItem('access_token', token);",
        "sessionStorage.setItem(AUTH_KEY, JSON.stringify(auth));"
      ],
      "nomatch": [
        "localStorage.setItem('theme', 'dark');",
        "this.token.set(response.accessToken);"
      ]
    },
    {
      "id": "SC-TS-BYPASS-TRUST",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.ts",
        "**/*.js"
      ],
      "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.min.js",
        "**/node_modules/**",
        "e2e/**",
        "**/e2e/**"
      ],
      "pattern": "\\bbypassSecurityTrust(Html|Style|Script|Url|ResourceUrl)\\s*\\(",
      "message": "bypassSecurityTrust turns off the Angular sanitizer for this value. Untrusted data here is XSS (CWE-79).",
      "fix": "Bind the value normally and let Angular sanitize it. Use bypassSecurityTrust only for a value that the code built from validated parts.",
      "match": [
        "return this.sanitizer.bypassSecurityTrustHtml(comment.body);",
        "this.url = this.sanitizer.bypassSecurityTrustResourceUrl(input);"
      ],
      "nomatch": [
        "this.safe = this.sanitizer.sanitize(SecurityContext.HTML, value);"
      ]
    },
    {
      "id": "SC-TS-INNERHTML",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.ts",
        "**/*.js"
      ],
      "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.min.js",
        "**/node_modules/**",
        "e2e/**",
        "**/e2e/**"
      ],
      "pattern": "\\.(innerHTML|outerHTML)\\s*\\+?=(?!=)",
      "message": "A direct innerHTML write skips the Angular sanitizer. Untrusted data here is XSS (CWE-79).",
      "fix": "Use a template binding ({{ }} or [innerHTML], which Angular sanitizes), or textContent for plain text.",
      "match": [
        "this.el.nativeElement.innerHTML = message;",
        "div.innerHTML += row;"
      ],
      "nomatch": [
        "this.el.nativeElement.textContent = message;",
        "if (div.innerHTML === '') { return; }"
      ]
    },
    {
      "id": "SC-TS-DOM-WRITE",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.ts",
        "**/*.js"
      ],
      "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.min.js",
        "**/node_modules/**",
        "e2e/**",
        "**/e2e/**"
      ],
      "pattern": "\\binsertAdjacentHTML\\s*\\(|\\bdocument\\.write(ln)?\\s*\\(",
      "message": "insertAdjacentHTML and document.write parse a string as HTML without the Angular sanitizer (CWE-79).",
      "fix": "Use a template binding or create the elements with the Renderer2 API and textContent.",
      "match": [
        "el.insertAdjacentHTML('beforeend', html);",
        "document.write(banner);"
      ],
      "nomatch": [
        "el.insertAdjacentText('beforeend', text);"
      ]
    },
    {
      "id": "SC-NG1-TRUST-HTML",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.ts",
        "**/*.js",
        "**/*.html",
        "**/*.cshtml"
      ],
      "exclude": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.min.js",
        "**/node_modules/**",
        "e2e/**",
        "**/e2e/**"
      ],
      "pattern": "\\$sce\\.trustAs(Html|Js|ResourceUrl|Url|Css)?\\s*\\(|\\$sceProvider\\.enabled\\s*\\(\\s*false\\s*\\)|\\bng-bind-html-unsafe\\b",
      "message": "AngularJS $sce trust calls and a disabled $sce render the value without sanitizing. Untrusted data here is XSS.",
      "fix": "Use ng-bind or {{ }} for text. For HTML, load ngSanitize and bind with ng-bind-html without a trust call.",
      "match": [
        "$scope.body = $sce.trustAsHtml(comment.body);",
        "$sceProvider.enabled(false);"
      ],
      "nomatch": [
        "<span ng-bind=\"comment.body\"></span>",
        "<div ng-bind-html=\"comment.body\"></div>"
      ]
    }
  ]
}
