{
  "skill": "playwright",
  "rules": [
    {"id": "PW-MSTEST-ADAPTER", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "\\bInclude\\s*=\\s*\"Microsoft\\.Playwright\\.MSTest\"",
     "message": "Microsoft.Playwright.MSTest is for MSTest 2 and 3. With MSTest 4 the build passes with MSTEST0082, and the run finds 0 tests. Use Microsoft.Playwright.MSTest.v4.",
     "fix": "With MSTest 4, reference Microsoft.Playwright.MSTest.v4 1.65.1. The namespace stays Microsoft.Playwright.MSTest. On MSTest 3, suppress with a reason.",
     "match": ["    <PackageReference Include=\"Microsoft.Playwright.MSTest\" Version=\"1.56.0\" />", "    <PackageVersion Include=\"Microsoft.Playwright.MSTest\" Version=\"1.65.1\" />"],
     "nomatch": ["    <PackageReference Include=\"Microsoft.Playwright.MSTest.v4\" />", "    <PackageVersion Include=\"Microsoft.Playwright.Xunit.v3\" Version=\"1.65.1\" />"]},
    {"id": "PW-FIXED-WAIT", "kind": "regex", "severity": "warning",
     "files": ["**/*.ts", "**/*.js", "**/*.mjs", "**/*.cs"],
     "pattern": "\\.\\s*(?:waitForTimeout|WaitForTimeoutAsync)\\s*\\(",
     "message": "A fixed wait is too short on a slow CI machine and too long on a fast one. The test gets flaky and slow.",
     "fix": "Wait for the result that the user sees with a web-first assertion: await expect(locator).toBeVisible() (.NET: await Expect(locator).ToBeVisibleAsync()). For time in the app, use page.clock.",
     "match": ["    await page.waitForTimeout(3000);", "        await Page.WaitForTimeoutAsync(500);"],
     "nomatch": ["    await expect(row).toBeVisible();", "    await page.clock.runFor('10:00');"]},
    {"id": "PW-DOTNET-CLI-TOOL", "kind": "regex", "severity": "warning",
     "files": ["**/*.yml", "**/*.yaml", "**/*.sh", "**/*.ps1", "**/*.cmd", "**/dotnet-tools.json", "**/Dockerfile*"],
     "pattern": "\\b[Mm]icrosoft\\.[Pp]laywright\\.(?:CLI|cli)\\b",
     "message": "The dotnet tool Microsoft.Playwright.CLI is deprecated (last version 1.2.3, 2022).",
     "fix": "Build the test project, then run pwsh <project>/bin/Debug/<tfm>/playwright.ps1 install --with-deps chromium.",
     "match": ["      - run: dotnet tool install --global Microsoft.Playwright.CLI", "    \"microsoft.playwright.cli\": {"],
     "nomatch": ["      - run: pwsh tests/Shop.E2E/bin/Debug/net10.0/playwright.ps1 install --with-deps chromium", "      - run: npx playwright install --with-deps chromium"]},
    {"id": "PW-RUNSETTINGS", "kind": "regex", "severity": "warning",
     "files": ["**/*.runsettings"],
     "pattern": "<Playwright>",
     "message": "On Microsoft.Testing.Platform (MSTest.Sdk, xUnit v3), Playwright ignores the <Playwright> section of .runsettings, and nothing reports it.",
     "fix": "Set BROWSER, HEADED, or PWDEBUG as environment variables, and the base URL, viewport, and locale in ContextOptions(). Keep the section only for a project on VSTest, and suppress with that reason.",
     "match": ["  <Playwright>", "<Playwright><BrowserName>firefox</BrowserName></Playwright>"],
     "nomatch": ["  <MSTest>", "  <RunConfiguration>"]},
    {"id": "PW-AGENT-UNPINNED", "kind": "regex", "severity": "warning",
     "files": ["**/.mcp.json", "**/mcp.json", "**/.claude/settings*.json", "**/*.sh", "**/*.ps1", "**/*.yml", "**/*.yaml"],
     "pattern": "@playwright/(?:mcp|cli)(?:@latest)?(?![@\\w.-])",
     "message": "An unpinned Playwright MCP server or CLI gives each person another tool set. The 0.0.x line changes about each 2 weeks.",
     "fix": "Pin the version: @playwright/mcp@0.0.86 or @playwright/cli@0.1.25. Or use npx playwright mcp / npx playwright cli with the version of the project.",
     "match": ["      \"args\": [\"@playwright/mcp@latest\"]", "      \"args\": [\"@playwright/mcp\", \"--headless\"]", "npm install -g @playwright/cli@latest"],
     "nomatch": ["      \"args\": [\"@playwright/mcp@0.0.86\", \"--isolated\"]", "npm install -g @playwright/cli@0.1.25"]},
    {"id": "PW-CSS-VISIBLE", "kind": "regex", "severity": "warning",
     "files": ["**/*.ts", "**/*.js", "**/*.mjs", "**/*.cs"],
     "pattern": "\\.\\s*[lL]ocator\\s*\\(\\s*['\"`][^'\"`]*:visible\\b",
     "message": "The CSS :visible in a selector is replaced by locator.visible() since Playwright 1.63.",
     "fix": "Use a role locator and .visible(): page.getByRole('button', { name: 'Save' }).visible().",
     "match": ["    await page.locator('button:visible').click();", "    await Page.Locator(\"button:visible\").ClickAsync();"],
     "nomatch": ["    await page.getByRole('button').visible().click();", "    await page.locator('#orders').click();"]},

    {"id": "DET-PW-01", "kind": "detect", "decision": "PW-01",
     "files": ["**/.mcp.json", "**/mcp.json", "**/.claude/settings*.json", "**/package.json"],
     "pattern": "@playwright/(?:mcp|cli)\\b|\\bplaywright-cli\\b",
     "match": ["      \"args\": [\"@playwright/mcp@0.0.86\"]", "    \"@playwright/cli\": \"0.1.25\","],
     "nomatch": ["    \"@playwright/test\": \"1.65.1\","]},
    {"id": "DET-PW-02", "kind": "detect", "decision": "PW-02",
     "files": ["**/*.csproj", "**/*.props"],
     "pattern": "\\bInclude\\s*=\\s*\"Microsoft\\.Playwright\\.(?:MSTest|Xunit|NUnit)(?:\\.v[34])?\"",
     "match": ["    <PackageReference Include=\"Microsoft.Playwright.MSTest.v4\" />", "    <PackageVersion Include=\"Microsoft.Playwright.Xunit.v3\" Version=\"1.65.1\" />"],
     "nomatch": ["    <PackageReference Include=\"Microsoft.Playwright\" />"]},
    {"id": "DET-PW-03", "kind": "detect", "decision": "PW-03",
     "files": ["**/*.cs"],
     "pattern": "\\.\\s*UseKestrel\\s*\\(\\s*0\\s*\\)|\\bDistributedApplicationTestingBuilder\\b",
     "match": ["        factory.UseKestrel(0);", "        var appHost = await DistributedApplicationTestingBuilder.CreateAsync<Projects.Shop_AppHost>();"],
     "nomatch": ["builder.WebHost.UseKestrel();"]}
  ]
}
