      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "--no-sandbox\\b|\\bPUPPETEER_DANGEROUS_NO_SANDBOX\\b",
      "message": "Without the Chromium sandbox, a renderer exploit runs code with the rights of the container.",
      "fix": "Run Chromium as a non-root user with the sandbox on. Accept --no-sandbox only for trusted templates, with an ADR and an isolated container.",
      "match": [
        "Args = [\"--no-sandbox\", \"--disable-setuid-sandbox\"],",
        "ENV PUPPETEER_DANGEROUS_NO_SANDBOX=true"
      ],
      "nomatch": [
        "Args = [\"--disable-dev-shm-usage\"],"
      ]
    },
    {
      "id": "SC-APPSETTINGS-SECRET",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/appsettings*.json"
      ],
      "pattern": "(?i)\\\"[\\w.:-]*(password|passwd|pwd|secret|apikey|api_key|accesskey|privatekey|accesstoken|refreshtoken|token|signingkey)\\\"\\s*:\\s*\\\"(?![<$#{])(?!(true|false)\\\")[^\\\"\\s]+\\\"|\\b(password|pwd)\\s*=\\s*(?![<$#{])[^;\\\"\\s]+",
      "message": "A secret value in appsettings is in Git, in the image and in each copy of the repository (CWE-798, SEC-07).",
      "fix": "Leave the value empty in appsettings. Read it from user-secrets in Development and from the secret store in other environments.",
      "match": [
        "\"ApiKey\": \"sk_live_abc123\"",
        "\"ClientSecret\": \"9f8e7d6c\"",
        "\"App\": \"Server=sql;Database=app;User Id=app;Password=Winter2026!\""
      ],
      "nomatch": [
        "\"ApiKey\": \"\"",
        "\"TokenLifetime\": \"00:05:00\"",
        "\"App\": \"Server=sql;Database=app;Integrated Security=true\""
      ],
      "exclude": [
        "**/rules.json"
      ]
    },
    {
      "id": "SC-PRIVATE-KEY",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/*.md",
        "**/rules.json"
      ],
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----",
      "message": "A private key is in the repository. Each person who can read the repository can use it.",
      "fix": "Remove the key, rotate it, and load it from the secret store. Scan the history with gitleaks.",
      "match": [
        "-----BEGIN RSA PRIVATE KEY-----",
        "-----BEGIN PRIVATE KEY-----"
      ],
      "nomatch": [
        "-----BEGIN CERTIFICATE-----",
        "-----BEGIN PUBLIC KEY-----"
      ]
    },
    {
      "id": "SC-DOCKER-SECRET-ARG",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/Dockerfile",
        "**/*.Dockerfile",
        "**/Containerfile",
        "**/Dockerfile.*"
      ],
      "pattern": "(?im)^\\s*(ARG|ENV)\\s+\\w*(PASSWORD|PASSWD|SECRET|TOKEN|API_?KEY|ACCESS_?KEY)\\w*\\b",
      "message": "ARG and ENV values stay in the image metadata and history. Each person who can pull the image can read them.",
      "fix": "Use a BuildKit secret mount: RUN --mount=type=secret,id=nuget ... and docker build --secret.",
      "match": [
        "ARG NUGET_TOKEN",
        "ENV API_KEY=abc"
      ],
      "nomatch": [
        "ENV PATH=\"$PATH:/root/.dotnet/tools\"",
        "RUN --mount=type=secret,id=nugetconfig,target=/root/.nuget/NuGet/NuGet.Config dotnet restore",
        "ENV ASPNETCORE_HTTP_PORTS=8080"
