      "pattern": "(?m)^\\s*-?\\s*uses:\\s*['\\\"]?[\\w.-]+/[\\w./-]+@(?![0-9a-f]{40}\\b)[\\w.-]+",
      "message": "A tag can move. In March 2026 attackers force-pushed the tags of trivy-action to malware.",
      "fix": "Pin the action to the full commit SHA and put the version in a comment: uses: owner/action@<40-hex-sha> # v4.2.1.",
      "match": [
        "      - uses: actions/checkout@v4",
        "  - uses: aquasecurity/trivy-action@0.28.0"
      ],
      "nomatch": [
        "      - uses: actions/checkout@08eba0b27e820071cde6df949e0beb9ba4906955 # v4.3.0",
        "      - uses: ./.github/actions/build"
      ]
