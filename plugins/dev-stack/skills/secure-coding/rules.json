    {
      "id": "SC-ACTION-NOT-PINNED",
      "kind": "regex",
      "severity": "warning",
      "files": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/action.yml",
        "**/action.yaml",
        "**/azure-pipelines*.yml",
        "**/.gitlab-ci.yml"
