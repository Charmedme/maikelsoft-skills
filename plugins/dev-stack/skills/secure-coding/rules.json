        "**/*.Dockerfile",
        "**/Containerfile",
        "**/Dockerfile.*",
        "**/*.sh",
        "**/*.yaml",
        "**/*.yml"
      ],
      "pattern": "(?i)trivy[^\\n]{0,40}(?<![\\d.])v?0\\.69\\.4\\b|(?<![\\d.])v?0\\.69\\.4\\b[^\\n]{0,40}trivy",
      "message": "Trivy v0.69.4 is the malicious release of March 2026 (CVE-2026-33634). It steals CI secrets.",
      "fix": "Use a current Trivy release, pin it by SHA or digest, verify the checksum, and rotate the secrets of each pipeline that ran v0.69.4.",
      "match": [
