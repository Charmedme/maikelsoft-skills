{
  "skill": "secure-coding",
  "rules": [
    {
      "id": "SC-TYPENAMEHANDLING",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\bTypeNameHandling\\s*(=|:)\\s*(Newtonsoft\\.Json\\.)?TypeNameHandling\\.(All|Auto|Objects|Arrays)\\b",
      "message": "Newtonsoft TypeNameHandling other than None lets the payload choose the type: remote code execution (CWE-502, CA2326).",
      "fix": "Use System.Text.Json with [JsonPolymorphic] and [JsonDerivedType] allowlists, or TypeNameHandling.None.",
      "match": [
        "var s = new JsonSerializerSettings { TypeNameHandling = TypeNameHandling.Auto };",
        "settings.TypeNameHandling = TypeNameHandling.All;",
        "new JsonSerializerSettings { TypeNameHandling = Newtonsoft.Json.TypeNameHandling.Objects }"
      ],
      "nomatch": [
        "var s = new JsonSerializerSettings { TypeNameHandling = TypeNameHandling.None };",
        "[JsonDerivedType(typeof(ShipmentCreated), \"shipment-created\")]"
      ]
    },
    {
      "id": "SC-BINARYFORMATTER",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets"
      ],
      "pattern": "\\b(BinaryFormatter|SoapFormatter|NetDataContractSerializer|LosFormatter|ObjectStateFormatter)\\b|<EnableUnsafeBinaryFormatterSerialization>\\s*true",
      "message": "BinaryFormatter and its relatives deserialize any type: remote code execution (CWE-502). .NET 9+ removed it on purpose.",
      "fix": "Use System.Text.Json or a typed contract serializer. Do not add the compatibility package.",
      "match": [
        "var f = new BinaryFormatter();",
        "<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>",
        "var s = new NetDataContractSerializer();"
      ],
      "nomatch": [
        "var e = JsonSerializer.Deserialize<ShipmentEvent>(json);",
        "var s = new DataContractSerializer(typeof(Order));"
      ]
    },
    {
      "id": "SC-PKG-BINARYFORMATTER",
      "kind": "package",
      "ecosystem": "nuget",
      "package": "System.Runtime.Serialization.Formatters",
      "versions": ">=9.0.0",
      "severity": "error",
      "message": "This compatibility package brings BinaryFormatter back, and with it remote code execution (CWE-502). Use System.Text.Json."
    },
    {
      "id": "SC-PKG-SECURITYCODESCAN",
      "kind": "package",
      "ecosystem": "nuget",
      "package": "SecurityCodeScan*",
      "versions": "*",
      "severity": "warning",
      "message": "SecurityCodeScan has no release since 2022. Use AnalysisModeSecurity=All and Semgrep CE or Opengrep."
    },
    {
      "id": "SC-PKG-SECURITY-SCAN",
      "kind": "package",
      "ecosystem": "nuget",
      "package": "security-scan",
      "versions": "*",
      "severity": "warning",
      "message": "security-scan (SecurityCodeScan) has no release since 2022. Use AnalysisModeSecurity=All and Semgrep CE or Opengrep."
    },
    {
      "id": "SC-CORS-ANY-CREDENTIALS",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\.AllowAnyOrigin\\s*\\(\\s*\\)[^;]*\\.AllowCredentials\\s*\\(\\s*\\)|\\.AllowCredentials\\s*\\(\\s*\\)[^;]*\\.AllowAnyOrigin\\s*\\(\\s*\\)",
      "message": "Any origin together with credentials lets each web site call the API as the signed-in user.",
      "fix": "List exact origins with WithOrigins(...) from configuration, or serve SPA and API on one origin (SEC-09).",
      "match": [
        "p.AllowAnyOrigin().AllowAnyHeader().AllowCredentials();",
        "p.AllowCredentials().AllowAnyMethod().AllowAnyOrigin();"
      ],
      "nomatch": [
        "p.WithOrigins(origins).AllowCredentials();",
        "p.AllowAnyOrigin().AllowAnyHeader();"
      ]
    },
    {
      "id": "SC-CORS-ANY-ORIGIN-FUNC",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\.SetIsOriginAllowed\\s*\\(\\s*(_|\\w+|\\(\\s*\\w*\\s*\\))\\s*=>\\s*true\\s*\\)",
      "message": "SetIsOriginAllowed(_ => true) accepts each origin. With credentials this is the same as no same-origin policy.",
      "fix": "Compare the origin with an allowlist from configuration, or use WithOrigins(...).",
      "match": [
        "p.SetIsOriginAllowed(_ => true).AllowCredentials();",
        "policy.SetIsOriginAllowed(origin => true);"
      ],
      "nomatch": [
        "p.SetIsOriginAllowed(origin => allowed.Contains(origin));",
        "p.WithOrigins(\"https://app.example.com\");"
      ]
    },
    {
      "id": "SC-CERT-ACCEPT-ALL",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\b(ServerCertificateCustomValidationCallback|ServerCertificateValidationCallback|RemoteCertificateValidationCallback)\\s*=\\s*(\\([^)]*\\)|\\w+)\\s*=>\\s*true\\b|\\bDangerousAcceptAnyServerCertificateValidator\\b",
      "message": "A callback that returns true turns off TLS server authentication. A man in the middle can read credentials and data (CA5359).",
      "fix": "Remove the callback. Fix the certificate chain (install the CA in the container) or pin the expected certificate.",
      "match": [
        "client.ServerCertificateValidationCallback = (s, c, h, e) => true;",
        "new HttpClientHandler { ServerCertificateCustomValidationCallback = (_, _, _, _) => true }",
        "handler.ServerCertificateCustomValidationCallback = HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;"
      ],
      "nomatch": [
        "client.ServerCertificateValidationCallback = ValidatePinnedCertificate;",
        "using var client = new SmtpClient();"
      ]
    },
    {
      "id": "SC-TRUST-SERVER-CERT",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs",
        "**/appsettings*.json",
        "**/*.yaml",
        "**/*.yml",
        "**/*.env"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/appsettings.Development.json",
        "**/appsettings.Local.json",
        "**/*.AppHost/**",
        "**/docker-compose*.yml",
        "**/compose*.yaml",
        "**/compose*.yml",
        "**/rules.json"
      ],
      "pattern": "(?i)\\bTrustServerCertificate\\s*=\\s*(true|yes)\\b",
      "message": "TrustServerCertificate=True accepts any database server certificate. A man in the middle can read the database traffic.",
      "fix": "Remove it outside local development. Install the CA of the database server, or use Encrypt=Strict with a valid certificate.",
      "match": [
        "\"App\": \"Server=sql;Database=app;Encrypt=True;TrustServerCertificate=True\"",
        "builder.TrustServerCertificate = true;"
      ],
      "nomatch": [
        "\"App\": \"Server=sql;Database=app;Encrypt=Strict\"",
        "builder.TrustServerCertificate = false;"
      ]
    },
    {
      "id": "SC-JWT-NO-LIFETIME",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "\\bValidateLifetime\\s*=\\s*false\\b",
      "message": "The API accepts expired tokens. A stolen token then works for ever (ASVS V9).",
      "fix": "Remove the line. Keep ValidateLifetime on and set ClockSkew to 1 or 2 minutes.",
      "match": [
        "o.TokenValidationParameters.ValidateLifetime = false;",
        "ValidateLifetime = false,"
      ],
      "nomatch": [
        "ValidateLifetime = true,",
        "o.TokenValidationParameters.ClockSkew = TimeSpan.FromMinutes(1);"
      ]
    },
    {
      "id": "SC-JWT-NO-AUDIENCE",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "\\bValidateAudience\\s*=\\s*false\\b",
      "message": "The API accepts tokens issued for other APIs of the same identity provider (token confusion, ASVS V9).",
      "fix": "Set Audience (or ValidAudiences) to the audience of this API and keep ValidateAudience on.",
      "match": [
        "ValidateAudience = false,",
        "p.ValidateAudience = false;"
      ],
      "nomatch": [
        "ValidateAudience = true,",
        "o.Audience = builder.Configuration[\"Auth:Audience\"];"
      ]
    },
    {
      "id": "SC-JWT-NO-ISSUER",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "\\bValidateIssuer\\s*=\\s*false\\b",
      "message": "The API accepts tokens from any issuer that has a trusted key. Only a multi-tenant API with its own IssuerValidator can turn this off.",
      "fix": "Set Authority (or ValidIssuer) and keep ValidateIssuer on. For multi-tenant Entra ID, set an IssuerValidator.",
      "match": [
        "ValidateIssuer = false,",
        "o.TokenValidationParameters.ValidateIssuer = false;"
      ],
      "nomatch": [
        "ValidateIssuer = true,",
        "o.Authority = builder.Configuration[\"Auth:Authority\"];"
      ]
    },
    {
      "id": "SC-JWT-UNSIGNED",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "\\b(RequireSignedTokens|ValidateIssuerSigningKey)\\s*=\\s*false\\b",
      "message": "The API accepts tokens without a checked signature (alg none or a forged token).",
      "fix": "Remove the setting. Let JwtBearer get the signing keys from the Authority and pin ValidAlgorithms.",
      "match": [
        "RequireSignedTokens = false,",
        "ValidateIssuerSigningKey = false,"
      ],
      "nomatch": [
        "RequireSignedTokens = true,",
        "o.TokenValidationParameters.ValidAlgorithms = [SecurityAlgorithms.RsaSha256];"
      ]
    },
    {
      "id": "SC-JWT-HTTP-METADATA",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "\\bRequireHttpsMetadata\\s*=\\s*false\\b",
      "message": "The signing keys come over plain HTTP. A man in the middle can supply his own keys.",
      "fix": "Use it only in local development, behind an environment check. Production uses an HTTPS Authority.",
      "match": [
        "o.RequireHttpsMetadata = false;"
      ],
      "nomatch": [
        "o.RequireHttpsMetadata = !builder.Environment.IsDevelopment();",
        "o.Authority = \"https://id.example.com/realms/app\";"
      ]
    },
    {
      "id": "SC-JWT-READ-NOT-VALIDATE",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "\\.ReadJwtToken\\s*\\(|\\.ReadToken\\s*\\(",
      "message": "ReadJwtToken and ReadToken decode a token without a signature check. Do not use the claims for a security decision.",
      "fix": "Let JwtBearer validate the token, or call JsonWebTokenHandler.ValidateTokenAsync.",
      "match": [
        "var jwt = new JwtSecurityTokenHandler().ReadJwtToken(raw);",
        "var t = handler.ReadToken(raw);"
      ],
      "nomatch": [
        "var result = await handler.ValidateTokenAsync(raw, parameters);"
      ]
    },
    {
      "id": "SC-JWT-HARDCODED-KEY",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "new\\s+SymmetricSecurityKey\\s*\\(\\s*Encoding\\.\\w+\\.GetBytes\\s*\\(\\s*\\$?@?\\\"",
      "message": "A signing key in source code is known to each person who can read the repository (CWE-798).",
      "fix": "Use the keys of the identity provider (Authority). For an own HMAC key, read it from the secret store.",
      "match": [
        "var key = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(\"super-secret-key-1234567890\"));"
      ],
      "nomatch": [
        "var key = new SymmetricSecurityKey(Convert.FromBase64String(options.SigningKey));"
      ]
    },
    {
      "id": "SC-DISABLE-ANTIFORGERY",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs",
        "**/*.cshtml"
      ],
      "pattern": "\\.DisableAntiforgery\\s*\\(|\\[IgnoreAntiforgeryToken\\b",
      "message": "This endpoint accepts a state change without an antiforgery token. With cookie authentication this is CSRF (CWE-352).",
      "fix": "Keep antiforgery for endpoints that a browser calls with a cookie. Disable it only for bearer-token or API-key endpoints, with a reason.",
      "match": [
        "app.MapPost(\"/upload\", Upload).DisableAntiforgery();",
        "[IgnoreAntiforgeryToken]"
      ],
      "nomatch": [
        "app.MapPost(\"/upload\", Upload).RequireAuthorization();",
        "[ValidateAntiForgeryToken]"
      ]
    },
    {
      "id": "SC-ALLOW-ANONYMOUS",
      "kind": "regex",
      "severity": "info",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\[AllowAnonymous\\]|\\.AllowAnonymous\\s*\\(",
      "message": "This endpoint is open to callers without a token. Check that this is intended and that it does not change state or return private data.",
      "fix": "Keep it only on the exact action that must be public (sign-in, health, public data). Add the route to the anonymous list in the authorization test.",
      "match": [
        "[AllowAnonymous]",
        "app.MapGet(\"/health\", () => Results.Ok()).AllowAnonymous();"
      ],
      "nomatch": [
        "app.MapGet(\"/orders\", GetOrders).RequireAuthorization(\"orders:read\");",
        "[Authorize(Policy = \"orders:read\")]"
      ]
    },
    {
      "id": "SC-WEAK-HASH-SECRET",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "pattern": "(?i)\\b(MD5|SHA1)\\w*\\b[^;\\n]*(password|passwd|pwd|passphrase|token|secret|apikey|api_key|otp|salt|resetcode)|(password|passwd|pwd|passphrase|token|secret|apikey|api_key|otp|salt|resetcode)\\w*\\b[^;\\n]*\\b(MD5|SHA1)\\w*\\b",
      "message": "MD5 and SHA1 are broken. For passwords even SHA256 is too fast (CA5350, CA5351).",
      "fix": "Passwords: the identity provider or PasswordHasher<T>. Tokens: RandomNumberGenerator plus SHA256 of the token. Integrity: HMACSHA256.",
      "match": [
        "var hash = MD5.HashData(Encoding.UTF8.GetBytes(password));",
        "var tokenHash = SHA1.HashData(bytes); // token",
        "string pwdHash = Convert.ToHexString(SHA1.HashData(data));"
      ],
      "nomatch": [
        "var hash = SHA256.HashData(Encoding.UTF8.GetBytes(token));",
        "var etag = Convert.ToHexString(MD5.HashData(fileBytes));"
      ]
    },
    {
      "id": "SC-RANDOM-SECRET",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "(?i)\\w*(token|password|passwd|pwd|secret|otp|nonce|salt|code)\\w*\\b[^;\\n]*(new\\s+Random\\s*\\(|Random\\.Shared)|(new\\s+Random\\s*\\(|Random\\.Shared)[^;\\n]*\\w*(token|password|secret|otp|nonce|salt)\\w*",
      "message": "System.Random is predictable. An attacker can guess the token, code or password (CWE-330, CA5394).",
      "fix": "Use RandomNumberGenerator.GetBytes, GetInt32, GetHexString or GetString.",
      "match": [
        "var code = new Random().Next(100000, 999999);",
        "var resetToken = Random.Shared.Next().ToString();"
      ],
      "nomatch": [
        "var code = RandomNumberGenerator.GetInt32(0, 1_000_000).ToString(\"D6\");",
        "var jitter = Random.Shared.Next(0, 100);"
      ]
    },
    {
      "id": "SC-DAPPER-SQL-INTERP",
      "kind": "regex",
      "severity": "error",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\.(Query|QueryAsync|QueryFirst\\w*|QuerySingle\\w*|QueryMultiple\\w*|Execute|ExecuteAsync|ExecuteScalar\\w*|ExecuteReader\\w*)\\s*(<[^>\\n]+>)?\\s*\\(\\s*(\\$@?\\\"|@\\$\\\"|\\$\\\"\\\"\\\"|\\\"[^\\\"\\n]*\\\"\\s*\\+)",
      "message": "Dapper puts an interpolated or concatenated value into the SQL text as is: SQL injection (CWE-89). Dapper parameterizes only the parameter object.",
      "fix": "Write the SQL as a constant with @Name placeholders and pass new { Name = value }. Map a dynamic column name through an allowlist.",
      "match": [
        "await conn.QueryAsync<Order>($\"SELECT * FROM orders WHERE ref = '{reference}'\");",
        "conn.Execute(\"DELETE FROM orders WHERE id = \" + id);"
      ],
      "nomatch": [
        "await conn.QueryAsync<Order>(\"SELECT * FROM orders WHERE ref = @Reference\", new { Reference = reference });",
        "await db.Orders.Where(o => o.Id == id).ExecuteDeleteAsync(ct);"
      ]
    },
    {
      "id": "SC-PROCESS-SHELL",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "pattern": "(?i)Process\\.Start\\s*\\(\\s*\\\"(/bin/)?(sh|bash|zsh|cmd(\\.exe)?|powershell(\\.exe)?|pwsh)\\\"|FileName\\s*=\\s*\\\"(/bin/)?(sh|bash|zsh|cmd(\\.exe)?|powershell(\\.exe)?|pwsh)\\\"",
      "message": "A shell parses its arguments. User input in the command line is OS command injection (CWE-78).",
      "fix": "Call the program directly with a fixed path and allowlisted arguments, or use a library instead of a process.",
      "match": [
        "Process.Start(\"sh\", $\"-c convert {name}\");",
        "var psi = new ProcessStartInfo { FileName = \"cmd.exe\" };"
      ],
      "nomatch": [
        "var psi = new ProcessStartInfo { FileName = \"/usr/bin/qpdf\" };"
      ]
    },
    {
      "id": "SC-DEV-EXCEPTION-PAGE",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "pattern": "^(?![^\\n]*IsDevelopment)[ \\t]{0,3}\\w+\\.UseDeveloperExceptionPage\\s*\\(",
      "message": "The developer exception page shows stack traces, source lines and configuration. Outside Development this leaks internals (CWE-209).",
      "fix": "Put the call in an IsDevelopment() check. Use AddProblemDetails and UseExceptionHandler for other environments.",
      "match": [
        "app.UseDeveloperExceptionPage();"
      ],
      "nomatch": [
        "if (app.Environment.IsDevelopment()) app.UseDeveloperExceptionPage();",
        "    app.UseDeveloperExceptionPage();"
      ]
    },
    {
      "id": "SC-LOG-SECRET",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "pattern": "(?i)\\bLog(Trace|Debug|Information|Warning|Error|Critical)?\\s*\\([^;]*\\{\\s*(password|passwd|pwd|secret|clientsecret|token|accesstoken|refreshtoken|idtoken|apikey|api_key|connectionstring|authorization|cookie)\\s*\\}",
      "message": "A log line with a password, token, key or connection string leaks a secret to each person who can read the logs (CWE-532).",
      "fix": "Do not log the value. Log an id, or mark the value with a data classification and turn on redaction (SEC-14).",
      "match": [
        "logger.LogInformation(\"Sign-in for {User} with {Password}\", user, password);",
        "_logger.LogDebug(\"Calling partner with {ApiKey}\", key);"
      ],
      "nomatch": [
        "logger.LogInformation(\"Token refreshed for {UserId}\", userId);",
        "logger.LogWarning(\"Sign-in failed for {UserName}\", userName);"
      ]
    },
    {
      "id": "SC-FORWARDED-TRUST-ALL",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs",
        "**/*.json",
        "**/*.yaml",
        "**/*.yml",
        "**/Dockerfile",
        "**/*.Dockerfile",
        "**/Containerfile",
        "**/*.env",
        "**/.env",
        "**/*.config"
      ],
      "pattern": "(?i)ASPNETCORE_FORWARDEDHEADERS_ENABLED\\W{1,4}\\\"?true|\\b(KnownProxies|KnownIPNetworks|KnownNetworks)\\.Clear\\s*\\(\\s*\\)",
      "message": "The app trusts X-Forwarded-For from each caller. A client can then fake its IP and get past rate limits and audit logs.",
      "fix": "Configure ForwardedHeadersOptions with KnownProxies or KnownIPNetworks of the gateway.",
      "match": [
        "\"ASPNETCORE_FORWARDEDHEADERS_ENABLED\": \"true\"",
        "ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true",
        "o.KnownProxies.Clear();"
      ],
      "nomatch": [
        "o.KnownIPNetworks.Add(System.Net.IPNetwork.Parse(\"10.0.0.0/8\"));"
      ],
      "exclude": [
        "**/rules.json"
      ]
    },
    {
      "id": "SC-CLIENT-FILENAME-PATH",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "pattern": "Path\\.Combine\\s*\\([^;\\n]*\\.FileName\\b|\\bWebRootPath\\b[^;\\n]*\\.FileName\\b",
      "message": "The client chooses the file name. In a path this allows path traversal and overwrite (CWE-22, CWE-434).",
      "fix": "Generate the storage name on the server (Guid). Keep the client name only as metadata.",
      "match": [
        "var path = Path.Combine(_env.WebRootPath, \"uploads\", file.FileName);",
        "var target = Path.Combine(root, upload.FileName);"
      ],
      "nomatch": [
        "var path = Path.Combine(root, $\"{Guid.NewGuid():N}.pdf\");",
        "var name = Path.GetFileName(file.FileName);"
      ]
    },
    {
      "id": "SC-NO-SIZE-LIMIT",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\[DisableRequestSizeLimit\\]|\\.DisableRequestSizeLimit\\s*\\(|\\bMaxRequestBodySize\\s*=\\s*null\\b",
      "message": "No limit on the request size: one caller can fill the memory or the disk (CWE-770, API4).",
      "fix": "Set an explicit limit per endpoint with [RequestSizeLimit] or WithFormOptions, and keep a global limit (SEC-12).",
      "match": [
        "[DisableRequestSizeLimit]",
        "k.Limits.MaxRequestBodySize = null;"
      ],
      "nomatch": [
        "k.Limits.MaxRequestBodySize = 1_000_000;",
        ".WithMetadata(new RequestSizeLimitAttribute(11 * 1024 * 1024));"
      ]
    },
    {
      "id": "SC-INSPECTOR-ALL-FORMATS",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/rules.json"
      ],
      "pattern": "new\\s+FileFormatInspector\\s*\\(\\s*\\)",
      "message": "This inspector knows about 70 formats, including executables. A non-null result does not mean that the type is allowed.",
      "fix": "Build the inspector from an allowlist: new FileFormatInspector(FileFormatLocator.GetFormats().Where(f => f is Pdf or Png)).",
      "match": [
        "services.AddSingleton<IFileFormatInspector>(new FileFormatInspector());"
      ],
      "nomatch": [
        "services.AddSingleton<IFileFormatInspector>(new FileFormatInspector(allowed));"
      ]
