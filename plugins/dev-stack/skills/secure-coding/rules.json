        "**/*.cs"
      ],
      "pattern": "\\.EnableRedaction\\s*\\(|\\bDataClassification(Attribute|Set)?\\b|\\.AddRedaction\\s*\\(",
      "match": [
        "builder.Logging.EnableRedaction();"
      ],
      "nomatch": [
        "builder.Logging.AddConsole();"
      ]
    },
    {
      "id": "SC-DET-SEC-15",
      "kind": "detect",
      "decision": "SEC-15",
      "files": [
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/nuget.config",
        "**/NuGet.Config",
        "**/.npmrc",
        "**/dependabot.yml",
        "**/renovate.json"
      ],
      "pattern": "<RestorePackagesWithLockFile>\\s*true|<packageSourceMapping>|\\bmin-release-age\\b|\\bcooldown\\s*:|\\bminimumReleaseAge\\b",
      "match": [
        "<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>",
        "min-release-age=3"
      ],
      "nomatch": [
        "<Nullable>enable</Nullable>"
      ],
      "exclude": [
        "**/rules.json"
      ]
    },
    {
      "id": "SC-DET-SEC-16",
      "kind": "detect",
      "decision": "SEC-16",
      "files": [
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/action.yml",
        "**/action.yaml",
        "**/azure-pipelines*.yml",
        "**/.gitlab-ci.yml"
      ],
      "pattern": "<AnalysisModeSecurity>|\\b(semgrep|opengrep)\\b|github/codeql-action",
      "match": [
        "<AnalysisModeSecurity>All</AnalysisModeSecurity>",
        "        run: semgrep scan --config p/csharp"
      ],
      "nomatch": [
        "<AnalysisLevel>latest</AnalysisLevel>"
      ]
    },
    {
      "id": "SC-DET-SEC-17",
      "kind": "detect",
      "decision": "SEC-17",
      "files": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/action.yml",
        "**/action.yaml",
        "**/azure-pipelines*.yml",
        "**/.gitlab-ci.yml",
        "**/.pre-commit-config.yaml",
        "**/.gitleaks.toml"
      ],
      "pattern": "(?i)\\b(gitleaks|betterleaks)\\b",
      "match": [
        "      - uses: gitleaks/gitleaks-action@ff98106e4c7b2bc287b24eaf42907196329070c7 # v2.3.9",
        "  - id: gitleaks"
      ],
      "nomatch": [
        "      - uses: actions/checkout@v4"
      ]
    },
    {
      "id": "SC-DET-SEC-18",
      "kind": "detect",
      "decision": "SEC-18",
      "files": [
        "**/*.md"
      ],
      "pattern": "(?i)\\bthreat model\\b|\\bSTRIDE\\b",
      "match": [
        "## Threat model",
        "STRIDE questions"
      ],
      "nomatch": [
        "## Design"
      ]
    },
    {
      "id": "SC-DET-SEC-20",
      "kind": "detect",
      "decision": "SEC-20",
      "files": [
        "**/*.cs"
      ],
      "pattern": "\\.PersistKeysTo\\w+\\s*(<[^>\\n]+>)?\\s*\\(|\\.ProtectKeysWith\\w+\\s*\\(",
      "match": [
        ".PersistKeysToDbContext<AppDbContext>();",
        ".ProtectKeysWithCertificate(cert);"
      ],
      "nomatch": [
        ".SetApplicationName(\"api\");"
      ]
    },
    {
      "id": "SC-DET-SEC-21",
      "kind": "detect",
      "decision": "SEC-21",
      "files": [
        "**/*.yaml",
        "**/*.yml"
      ],
      "pattern": "pod-security\\.kubernetes\\.io/enforce|^\\s*kind:\\s*NetworkPolicy\\b",
      "match": [
        "    pod-security.kubernetes.io/enforce: restricted",
        "kind: NetworkPolicy"
      ],
      "nomatch": [
        "kind: Deployment"
      ]
    },
    {
      "id": "SC-DET-SEC-22",
      "kind": "detect",
      "decision": "SEC-22",
      "files": [
        "**/*.cs",
        "**/appsettings*.json"
      ],
      "pattern": "(?i)\\bclient_credentials\\b|\\bClientCredentials\\w*\\b|AddClientCredentialsTokenManagement",
      "match": [
        "GrantType = \"client_credentials\"",
        "services.AddClientCredentialsTokenManagement();"
      ],
      "nomatch": [
        "GrantType = \"authorization_code\""
      ],
      "exclude": [
        "**/rules.json"
      ]
    },
    {
      "id": "SC-DET-SEC-23",
      "kind": "detect",
      "decision": "SEC-23",
      "files": [
        "**/*.cs"
      ],
      "pattern": "(?i)\\b\\w*audit(log|trail|entry|event)\\w*\\b",
      "match": [
        "public DbSet<AuditEntry> AuditEntries => Set<AuditEntry>();",
        "await auditLog.WriteAsync(entry, ct);"
      ],
      "nomatch": [
        "logger.LogInformation(\"Saved {Id}\", id);"
      ]
    }
