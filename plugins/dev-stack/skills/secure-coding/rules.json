    {
      "id": "SC-SMTP-NO-TLS",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs",
        "**/appsettings*.json"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**",
        "**/*.Tests/**",
        "**/*.Test/**",
        "**/appsettings.Development.json",
        "**/rules.json"
      ],
      "pattern": "\\bSecureSocketOptions\\.(Auto|StartTlsWhenAvailable|None)\\b|\\\"Security\\\"\\s*:\\s*\\\"(Auto|StartTlsWhenAvailable|None)\\\"",
      "message": "Auto and StartTlsWhenAvailable continue in plain text when the server does not offer STARTTLS. Credentials and mail then travel unencrypted.",
      "fix": "Use SecureSocketOptions.StartTls on port 587 or SslOnConnect on port 465. Use None only for a local test server.",
      "match": [
        "await client.ConnectAsync(host, 587, SecureSocketOptions.Auto, ct);",
        "\"Security\": \"StartTlsWhenAvailable\""
      ],
      "nomatch": [
        "await client.ConnectAsync(host, 587, SecureSocketOptions.StartTls, ct);"
      ]
    },
    {
      "id": "SC-NO-SANDBOX",
      "kind": "regex",
      "severity": "warning",
      "files": [
        "**/*.cs",
        "**/Dockerfile",
        "**/*.Dockerfile",
        "**/Containerfile",
        "**/Dockerfile.*",
        "**/*.yaml",
        "**/*.yml",
        "**/*.json",
        "**/*.env"
