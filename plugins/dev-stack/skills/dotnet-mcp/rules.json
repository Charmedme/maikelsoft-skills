{
  "skill": "dotnet-mcp",
  "rules": [
    {"id": "MCP-STDOUT", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs"],
     "unless": "\\A(?![\\s\\S]*(?:ModelContextProtocol|McpServer))|\\b(?:WithHttpTransport|MapMcp)\\b",
     "pattern": "\\bConsole\\s*\\.\\s*(?:Out\\s*\\.\\s*)?Write(?:Line)?(?:Async)?\\s*\\(",
     "message": "In a stdio MCP server, stdout carries only JSON-RPC. One stray line breaks the client.",
     "fix": "Log through ILogger with AddConsole(o => o.LogToStandardErrorThreshold = LogLevel.Trace), or write to Console.Error.",
     "match": ["builder.Services.AddMcpServer().WithStdioServerTransport(); Console.WriteLine(\"ready\");", "[McpServerTool] public static string Echo(string m) { Console.Out.WriteLine(m); return m; }"],
     "nomatch": ["[McpServerTool] public static string Echo(string m) { Console.Error.WriteLine(m); return m; }", "[McpServerTool] public string Echo(string m) { logger.LogInformation(\"echo\"); return m; }"]},
    {"id": "MCP-HTTP-STATEFUL", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bEnableLegacySse\\s*=\\s*true\\b|\\bStateless\\s*=\\s*false\\b|\\bSessionMode\\s*=\\s*HttpServerSessionMode\\s*\\.\\s*Stateful\\b",
     "message": "Stateful MCP sessions and the legacy SSE transport need sticky sessions and serve only clients on spec 2025-11-25 or earlier (MCP9004, MCP9006).",
     "fix": "Keep the stateless default, pass state as a handle argument, and ask the user through InputRequiredException (MRTR). Stateful mode only after decision MCP-02.",
     "match": ["    o.Stateless = false;", "    options.EnableLegacySse = true;", "    o.SessionMode = HttpServerSessionMode.Stateful;"],
     "nomatch": ["    o.Stateless = true;", "    o.SessionMode = HttpServerSessionMode.Stateless;", "    o.SessionMode = HttpServerSessionMode.StatefulForInitializeClients;"]},
    {"id": "MCP-SERVER-REQUEST", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs"],
     "pattern": "\\.\\s*(?:ElicitAsync|SampleAsync|RequestRootsAsync|AsSamplingChatClient)\\s*\\(",
     "message": "ElicitAsync, SampleAsync, and RequestRootsAsync throw in stateless HTTP mode. Sampling and Roots are deprecated (MCP9005).",
     "fix": "Throw InputRequiredException after a check of server.IsMrtrSupported. Call the LLM provider directly instead of sampling.",
     "match": ["var answer = await server.ElicitAsync(request, cancellationToken);", "var reply = await server.SampleAsync(messages, ct);", "IChatClient chat = server.AsSamplingChatClient();"],
     "nomatch": ["throw new InputRequiredException(inputs, requestState: orderId);", "if (server.IsMrtrSupported)"]},
    {"id": "MCP-PRM-MANUAL", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bMap(?:Get|Methods)?\\s*\\(\\s*\"/?\\.well-known/oauth-protected-resource",
     "message": "A hand-written protected resource metadata endpoint drifts from the WWW-Authenticate header and the audience check.",
     "fix": "Use .AddMcp(o => o.ResourceMetadata = new() { Resource = serverUrl, AuthorizationServers = { authority } }) with McpAuthenticationDefaults.AuthenticationScheme as the challenge scheme.",
     "match": ["app.MapGet(\"/.well-known/oauth-protected-resource\", () => Results.Json(metadata));", "app.Map(\"/.well-known/oauth-protected-resource/mcp\", handler);"],
     "nomatch": ["app.MapMcp(\"/mcp\").RequireAuthorization();", ".AddMcp(o => o.ResourceMetadata = new() { Resource = serverUrl });"]},
    {"id": "MCP-SERVERJSON-SCHEMA", "kind": "regex", "severity": "warning",
     "files": ["**/server.json"],
     "pattern": "/schemas/(?:2024-\\d\\d-\\d\\d|2025-(?:0\\d|1[01])-\\d\\d)/server\\.schema\\.json",
     "message": "The server.json schema is older than 2025-12-11. The mcpserver template still writes 2025-10-17.",
     "fix": "Use \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json\".",
     "match": ["  \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json\",", "  \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json\","],
     "nomatch": ["  \"$schema\": \"https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json\","]},
    {"id": "MCP-PKG-OLD", "kind": "package", "ecosystem": "nuget",
     "package": "ModelContextProtocol*", "versions": "<2.0.0", "severity": "warning",
     "message": "ModelContextProtocol 0.x and 1.x predate spec 2026-07-28: no stateless default, no MRTR. The mcpserver template of SDK 10 references 1.2.0.",
     "fix": "Reference 2.4.0 with an exact version. In existing code, upgrade only when the task asks for it (references/upgrade-2x.md)."},

    {"id": "DET-MCP-01", "kind": "detect", "decision": "MCP-01", "files": ["**/*.cs"],
     "pattern": "\\.\\s*With(?:Stdio|Http)ServerTransport\\s*\\(|\\.\\s*WithHttpTransport\\s*\\(",
     "match": ["    .WithStdioServerTransport()", "    .WithHttpTransport(o => o.SessionMode = HttpServerSessionMode.Stateless)"],
     "nomatch": ["    .WithToolsFromAssembly();"]},
    {"id": "DET-MCP-02", "kind": "detect", "decision": "MCP-02", "files": ["**/*.cs"],
     "pattern": "\\bSessionMode\\s*=\\s*HttpServerSessionMode\\b|\\bStateless\\s*=\\s*(?:true|false)\\b",
     "match": ["    o.SessionMode = HttpServerSessionMode.Stateless;", "    options.Stateless = true;"],
     "nomatch": ["    o.IdleTimeout = TimeSpan.FromMinutes(5);"]},
    {"id": "DET-MCP-03", "kind": "detect", "decision": "MCP-03", "files": ["**/*.cs"],
     "pattern": "\\.\\s*AddMcp\\s*\\(|\\bMcpAuthenticationDefaults\\b",
     "match": [".AddMcp(o => o.ResourceMetadata = new() { Resource = serverUrl });", "    o.DefaultChallengeScheme = McpAuthenticationDefaults.AuthenticationScheme;"],
     "nomatch": ["builder.Services.AddMcpServer()", "    o.DefaultChallengeScheme = JwtBearerDefaults.AuthenticationScheme;"]},
    {"id": "DET-MCP-05", "kind": "detect", "decision": "MCP-05", "files": ["**/*.cs"],
     "pattern": "\\bnew\\s+InputRequiredException\\s*\\(",
     "match": ["    throw new InputRequiredException(inputs, requestState: orderId);"],
     "nomatch": ["    if (!server.IsMrtrSupported)"]},
    {"id": "DET-MCP-06", "kind": "detect", "decision": "MCP-06", "files": ["**/*.csproj"],
     "pattern": "<PackageType>\\s*McpServer\\s*</PackageType>",
     "match": ["    <PackageType>McpServer</PackageType>"],
     "nomatch": ["    <PackAsTool>true</PackAsTool>"]},
    {"id": "DET-MCP-07", "kind": "detect", "decision": "MCP-07", "files": ["**/*.cs"],
     "pattern": "\\bUseStructuredContent\\s*=\\s*true\\b",
     "match": ["[McpServerTool(Name = \"get_order_status\", ReadOnly = true, UseStructuredContent = true)]"],
     "nomatch": ["[McpServerTool(Name = \"get_order_status\", ReadOnly = true)]"]}
  ]
}
