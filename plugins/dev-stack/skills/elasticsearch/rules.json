{
  "skill": "elasticsearch",
  "rules": [
    {"id": "ES-USING-NEST", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "^\\s*using\\s+(Nest|Elasticsearch\\.Net)\\s*;",
     "message": "NEST and Elasticsearch.Net are deprecated and do not work with an Elasticsearch 9 server.",
     "fix": "Use Elastic.Clients.Elasticsearch with the client major of the server major. See references/migration.md.",
     "match": ["using Nest;", "using Elasticsearch.Net;"],
     "nomatch": ["using Elastic.Clients.Elasticsearch;", "using Elastic.Transport;"]},
    {"id": "ES-REFRESH-TRUE", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs"],
     "pattern": "\\bRefresh\\s*\\.\\s*True\\b|[?&]refresh=true\\b",
     "message": "A forced refresh on each write makes many small segments, and the merges cost CPU and I/O.",
     "fix": "Use the default refresh. Use Refresh.WaitFor only when the user must read their own write, never in a loop. Tests call Indices.RefreshAsync.",
     "match": ["i.Index(\"products\").Refresh(Refresh.True)", "var url = \"/products/_doc/1?refresh=true\";"],
     "nomatch": ["i.Index(\"products\").Refresh(Refresh.WaitFor)", "i.Index(\"products\").Id(doc.Id)"]},
    {"id": "ES-TLS-OFF", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs"],
     "pattern": "ServerCertificateValidationCallback\\s*\\(\\s*(CertificateValidations\\s*\\.\\s*AllowAll|\\([^)\\n]*\\)\\s*=>\\s*true)|DangerousAcceptAnyServerCertificateValidator",
     "message": "TLS validation is off. Anyone on the network path can read and change the search traffic and the API key.",
     "fix": "Trust the cluster CA: CertificateFingerprint(sha256) or CertificateValidations.AuthorityIsRoot(ca).",
     "match": ["settings.ServerCertificateValidationCallback(CertificateValidations.AllowAll);", ".ServerCertificateValidationCallback((_, _, _, _) => true)"],
     "nomatch": [".ServerCertificateValidationCallback(CertificateValidations.AuthorityIsRoot(ca));", "settings.CertificateFingerprint(fingerprint);"]},
    {"id": "ES-NEW-CLIENT", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["**/Program.cs", "**/*Extensions.cs", "tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs"],
     "pattern": "\\bnew\\s+ElasticsearchClient\\s*\\(",
     "message": "A client made outside startup loses the connection pool and the metadata cache, and opens new connections.",
     "fix": "Register one ElasticsearchClient as a singleton at startup and inject it.",
     "match": ["var client = new ElasticsearchClient(settings);", "using var c = new ElasticsearchClient(new Uri(url));"],
     "nomatch": ["public sealed class ProductSearch(ElasticsearchClient client)", "services.AddSingleton(sp => sp.GetRequiredService<SearchClientFactory>().Client);"]},
    {"id": "ES-QUERY-STRING", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\.\\s*QueryString\\s*\\(|\\bnew\\s+QueryStringQuery\\b",
     "message": "query_string on user input lets a user search any field, run expensive wildcard or regex queries, and get a 400 for a typo.",
     "fix": "Use match (with Fuzziness for typo tolerance) or simple_query_string with a list of fields.",
     "match": ["q => q.QueryString(qs => qs.Query(input))", "new Query { QueryString = new QueryStringQuery { Query = text } }"],
     "nomatch": ["q => q.SimpleQueryString(qs => qs.Query(input))", "q => q.Match(m => m.Field(f => f.Name).Query(text))"]},
    {"id": "ES-MAX-RESULT-WINDOW", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs", "**/*.json"],
     "pattern": "\\bMaxResultWindow\\s*\\(|max_result_window\"?\\s*[:=]\\s*\\d",
     "message": "A larger max_result_window moves the deep paging problem and costs memory on each shard.",
     "fix": "Keep from + size at or below 10,000. Use search_after, and a point in time for an export.",
     "match": ["s => s.MaxResultWindow(100000)", "\"index.max_result_window\": 50000"],
     "nomatch": ["s => s.NumberOfShards(1).NumberOfReplicas(1)", ".Pit(p => p.Id(pitId).KeepAlive(\"1m\"))", "private const int MaxWindow = 10_000; // index.max_result_window: deeper pages need search_after"]},
    {"id": "ES-PKG-NEST", "kind": "package", "ecosystem": "nuget",
     "package": "NEST", "versions": "*", "severity": "error",
     "message": "NEST is deprecated (7.17.5) and does not work with an Elasticsearch 9 server.",
     "fix": "Move to Elastic.Clients.Elasticsearch. See references/migration.md."},
    {"id": "ES-PKG-ESNET", "kind": "package", "ecosystem": "nuget",
     "package": "Elasticsearch.Net", "versions": "*", "severity": "error",
     "message": "Elasticsearch.Net is the deprecated low-level client of NEST.",
     "fix": "Use Elastic.Clients.Elasticsearch, or client.Transport.RequestAsync for an API that the client does not cover."},

    {"id": "DET-SEARCH-01", "kind": "detect", "decision": "SEARCH-01", "files": ["**/*.cs"],
     "pattern": "^\\s*using\\s+Elastic\\.Clients\\.Elasticsearch\\s*;|EF\\.Functions\\.(ToTsVector|WebSearchToTsQuery|PlainToTsQuery|FreeText|Contains)\\s*\\(|\\bNpgsqlTsVector\\b",
     "match": ["using Elastic.Clients.Elasticsearch;", ".Where(p => p.SearchVector.Matches(EF.Functions.WebSearchToTsQuery(\"english\", text)))", "public NpgsqlTsVector SearchVector { get; set; }"],
     "nomatch": ["using Microsoft.EntityFrameworkCore;", ".Where(p => p.Name.Contains(text))"]},
    {"id": "DET-SEARCH-02", "kind": "detect", "decision": "SEARCH-02", "files": ["**/*.cs"],
     "pattern": "VersionType\\s*\\.\\s*External\\b",
     "match": ["op.Id(d.Id).VersionType(VersionType.External).Version(d.Version)"],
     "nomatch": ["op.Id(d.Id)"]},
    {"id": "DET-SEARCH-03", "kind": "detect", "decision": "SEARCH-03", "files": ["**/*.cs"],
     "pattern": "\\bIsWriteIndex\\s*\\(|\\bUpdateAliasesAsync\\s*\\(",
     "match": [".Aliases(a => a.Add(Alias, alias => alias.IsWriteIndex(true)))", "await client.Indices.UpdateAliasesAsync(a => a"],
     "nomatch": ["await client.Indices.CreateAsync<OrderDocument>(\"orders\", ct);"]},
    {"id": "DET-SEARCH-04", "kind": "detect", "decision": "SEARCH-04",
     "files": ["**/*.csproj", "**/*.props", "**/*compose*.yml", "**/*compose*.yaml"],
     "pattern": "Include=\"(Elastic\\.Clients\\.Elasticsearch|OpenSearch\\.Client|NEST)\"|image:\\s*[\"']?(docker\\.elastic\\.co/elasticsearch/elasticsearch|elasticsearch|opensearchproject/opensearch):",
     "match": ["<PackageVersion Include=\"Elastic.Clients.Elasticsearch\" Version=\"9.5.3\" />", "    image: elasticsearch:9.5.5", "<PackageReference Include=\"OpenSearch.Client\" />"],
     "nomatch": ["<PackageVersion Include=\"Testcontainers.Elasticsearch\" Version=\"4.16.0\" />", "    image: postgres:18.6-alpine"]},
    {"id": "DET-SEARCH-05", "kind": "detect", "decision": "SEARCH-05", "files": ["**/*.cs"],
     "pattern": "\\.\\s*ThrowExceptions\\s*\\(|\\bEnsureValid\\s*<|static\\s+\\w+\\s+EnsureValid\\s*<",
     "match": ["var settings = new ElasticsearchClientSettings(uri).ThrowExceptions();", "public static T EnsureValid<T>(this T response)"],
     "nomatch": ["if (!response.IsValidResponse) { return; }"]},
    {"id": "DET-SEARCH-06", "kind": "detect", "decision": "SEARCH-06", "files": ["**/*.cs", "**/*.json"],
     "pattern": "\\.Analyzer\\s*\\(\\s*\"(dutch|german)\"|\"analyzer\"\\s*:\\s*\"(dutch|german)\"",
     "match": [".Text(d => d.DescriptionNl, t => t.Analyzer(\"dutch\"))", "\"analyzer\": \"german\""],
     "nomatch": [".Text(d => d.Name, t => t.Analyzer(\"standard\"))"]}
  ]
}
