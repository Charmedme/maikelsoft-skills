{
  "skill": "efcore",
  "rules": [
    {"id": "EF-RAW-SQL-INTERP", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "\\b(FromSqlRaw|ExecuteSqlRaw(Async)?|SqlQueryRaw)\\s*(<[^>\\n]+>)?\\s*\\(\\s*(\\$@?\"|@\\$\")",
     "message": "An interpolated string in a Raw SQL method is SQL injection. C# builds the string before EF sees it, so EF cannot make parameters.",
     "fix": "Use FromSql, SqlQuery, or ExecuteSqlAsync with the interpolated string. EF then sends each value as a parameter.",
     "match": [
       "var users = db.Users.FromSqlRaw($\"SELECT * FROM Users WHERE Name = '{name}'\");",
       "await db.Database.ExecuteSqlRawAsync($@\"DELETE FROM Orders WHERE Id = {id}\", ct);",
       "db.Database.SqlQueryRaw<int>($\"SELECT COUNT(*) FROM {table}\")"
     ],
     "nomatch": [
       "var users = db.Users.FromSql($\"SELECT * FROM Users WHERE Name = {name}\");",
       "db.Customers.FromSqlRaw(\"SELECT * FROM Customers WHERE Name = {0}\", name)",
       "await db.Database.ExecuteSqlAsync($\"DELETE FROM Orders WHERE Id = {id}\", ct);"
     ]},
    {"id": "EF-RAW-SQL-CONCAT", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "\\b(FromSqlRaw|ExecuteSqlRaw(Async)?|SqlQueryRaw)\\s*(<[^>\\n]+>)?\\s*\\((?=[^;\\n]*(\"\\s*\\+|\\+\\s*\\$?@?\"|string\\.(Format|Concat)\\s*\\())",
     "message": "Concatenated SQL in a Raw SQL method is SQL injection when a part comes from input.",
     "fix": "Use FromSql or ExecuteSqlAsync with an interpolated string. For a dynamic identifier, check it against an allow list, build the SQL on a separate line, and pass values as {0} parameters.",
     "match": [
       "db.Users.FromSqlRaw(\"SELECT * FROM Users WHERE Name = '\" + name + \"'\")",
       "await db.Database.ExecuteSqlRawAsync(\"DELETE FROM \" + table, ct);",
       "db.Users.FromSqlRaw(string.Format(\"SELECT * FROM Users WHERE Id = {0}\", id))"
     ],
     "nomatch": [
       "db.Customers.FromSqlRaw(sql, name).ToListAsync(ct);",
       "db.Customers.FromSqlRaw(\"SELECT * FROM Customers WHERE Name = {0}\", name)",
       "var sql = \"SELECT * FROM Customers ORDER BY \" + column;"
     ]},
    {"id": "EF-INMEMORY", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bUseInMemoryDatabase\\s*\\(",
     "message": "The EF InMemory provider is not a relational database: no transactions, no SQL, no constraints, other case rules. Microsoft discourages it for tests.",
     "fix": "Test against the production engine in a container (Testcontainers). See dev-stack:dotnet-testing.",
     "match": ["options.UseInMemoryDatabase(\"test\");", "new DbContextOptionsBuilder<AppDbContext>().UseInMemoryDatabase(Guid.NewGuid().ToString())"],
     "nomatch": ["options.UseNpgsql(container.GetConnectionString());", "services.AddDbContext<AppDbContext>(o => o.UseSqlServer(cs));"]},
    {"id": "EF-PKG-INMEMORY", "kind": "package", "ecosystem": "nuget",
     "package": "Microsoft.EntityFrameworkCore.InMemory", "versions": "*", "severity": "warning",
     "message": "The EF InMemory provider gives tests that pass while the real database fails. Use Testcontainers with the production engine."},
    {"id": "EF-ENSURE-CREATED", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs"],
     "pattern": "\\.Ensure(Created|Deleted)(Async)?\\s*\\(",
     "message": "EnsureCreated makes a schema without the migrations history, so later migrations fail. EnsureDeleted drops the database.",
     "fix": "Use migrations. Apply them with a migration bundle or an idempotent script (decision DATA-18).",
     "match": ["db.Database.EnsureCreated();", "await context.Database.EnsureCreatedAsync(ct);", "await db.Database.EnsureDeletedAsync();"],
     "nomatch": ["await db.Database.MigrateAsync(ct);", "var created = order.EnsureValid();"]},
    {"id": "EF-STARTUP-MIGRATE", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs", "**/Migrations/**"],
     "pattern": "\\bDatabase\\s*\\.\\s*Migrate(Async)?\\s*\\(",
     "message": "Migration at application start runs on each replica with DDL rights and without SQL review (decision DATA-18).",
     "fix": "Apply migrations with a migration bundle job or an idempotent script. Keep startup migration only for a single-instance tool, with a suppression comment that gives the reason.",
     "match": ["db.Database.Migrate();", "await scope.ServiceProvider.GetRequiredService<AppDbContext>().Database.MigrateAsync(ct);"],
     "nomatch": ["// apply with: ./efbundle --connection \"$CONN\"", "await strategy.ExecuteAsync(ct => db.SaveChangesAsync(ct), ct);"]},
    {"id": "EF-PKG-BULKEXT", "kind": "package", "ecosystem": "nuget",
     "package": "EFCore.BulkExtensions*", "versions": "*", "severity": "warning",
     "message": "EFCore.BulkExtensions has a dual license: free only below its criteria, else a paid license (decision DATA-22). Ask the human before you use it."},
    {"id": "EF-PKG-ZZZ", "kind": "package", "ecosystem": "nuget",
     "package": "Z.EntityFramework.Extensions*", "versions": "*", "severity": "warning",
     "message": "Z.EntityFramework.Extensions has a commercial license (decision DATA-22). Ask the human before you use it."},
    {"id": "EF-XMIN-OLD", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bUseXminAsConcurrencyToken\\s*\\(",
     "message": "UseXminAsConcurrencyToken is the old EFCore.PG API (obsolete since 7, not in 10).",
     "fix": "Add [Timestamp] public uint Version { get; set; } or configure a uint property with IsRowVersion(). EFCore.PG maps it to xmin.",
     "match": ["modelBuilder.Entity<Order>().UseXminAsConcurrencyToken();", "b.UseXminAsConcurrencyToken ();"],
     "nomatch": ["[Timestamp] public uint Version { get; set; }", "b.Property(o => o.Version).IsRowVersion();"]},
    {"id": "EF-LAZY-PROXIES", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bUseLazyLoadingProxies\\s*\\(",
     "message": "Lazy loading hides one query per navigation access (N+1) and does synchronous I/O.",
     "fix": "Load related data in the same query with a Select projection or Include.",
     "match": ["options.UseLazyLoadingProxies().UseSqlServer(cs);"],
     "nomatch": ["var orders = await db.Orders.Include(o => o.Lines).ToListAsync(ct);"]},
    {"id": "EF-PKG-PROXIES", "kind": "package", "ecosystem": "nuget",
     "package": "Microsoft.EntityFrameworkCore.Proxies", "versions": "*", "severity": "warning",
     "message": "The proxies package enables lazy loading, a main cause of N+1 queries in server apps."},
    {"id": "EF-GLOBAL-SPLIT", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "UseQuerySplittingBehavior\\s*\\(\\s*QuerySplittingBehavior\\.SplitQuery",
     "message": "Split queries for all queries add round trips and can read inconsistent data.",
     "fix": "Keep single queries as the default. Add AsSplitQuery() on a query with two or more sibling collection Includes.",
     "match": ["sql.UseQuerySplittingBehavior(QuerySplittingBehavior.SplitQuery);"],
     "nomatch": ["db.Orders.Include(o => o.Lines).Include(o => o.Notes).AsSplitQuery()", "sql.UseQuerySplittingBehavior(QuerySplittingBehavior.SingleQuery);"]},
    {"id": "EF-SENSITIVE-LOGGING", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bEnableSensitiveDataLogging\\s*\\(\\s*(true\\s*)?\\)",
     "message": "Sensitive data logging writes parameter values (personal data, secrets) to the logs.",
     "fix": "Turn it on only in development: EnableSensitiveDataLogging(env.IsDevelopment()).",
     "match": ["options.EnableSensitiveDataLogging();", "options.EnableSensitiveDataLogging(true);"],
     "nomatch": ["options.EnableSensitiveDataLogging(env.IsDevelopment());"]},
    {"id": "EF-LEGACY-TIMESTAMP", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "Npgsql\\.EnableLegacyTimestampBehavior\"\\s*,\\s*true",
     "message": "The legacy timestamp switch hides local times that go to timestamptz. It is a migration aid, not a fix.",
     "fix": "Write UTC values: DateTimeOffset with offset zero, or DateTime with Kind Utc, from TimeProvider.",
     "match": ["AppContext.SetSwitch(\"Npgsql.EnableLegacyTimestampBehavior\", true);"],
     "nomatch": ["AppContext.SetSwitch(\"Npgsql.EnableLegacyTimestampBehavior\", false);", "entity.CreatedAt = clock.GetUtcNow();"]},
    {"id": "EF-GUID-KEY", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs", "**/Migrations/**"],
     "pattern": "\\bId\\s*(\\{[^}\\n]*\\}\\s*)?=\\s*Guid\\.(NewGuid|CreateVersion7)\\s*\\(",
     "message": "A random GUID key fragments the index. Guid.CreateVersion7 is not in order for SQL Server (decision DATA-07).",
     "fix": "Do not set the key. The EF provider generates it on Add: sequential on SQL Server, UUIDv7 on EFCore.PG 9+.",
     "match": ["public Guid Id { get; set; } = Guid.NewGuid();", "var order = new Order { Id = Guid.NewGuid(), Reference = r };", "Id = Guid.CreateVersion7(),"],
     "nomatch": ["var correlationId = Guid.NewGuid();", "OrderId = Guid.NewGuid(),", "public Guid Id { get; set; }"]},
    {"id": "EF-OWNED-TYPE", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["**/Migrations/**"],
     "pattern": "\\.Owns(One|Many)\\s*(<[^>\\n]+>)?\\s*\\(",
     "message": "EF 10 maps value objects and JSON documents as complex types. Owned types are entity types with a hidden key.",
     "fix": "For new code use ComplexProperty or ComplexCollection, with ToJson() for a JSON column. Existing code keeps its style.",
     "match": ["b.OwnsOne(o => o.Address);", "b.OwnsMany(o => o.Lines, l => l.ToJson());", "b.OwnsOne<Address>(\"Address\");"],
     "nomatch": ["b.ComplexProperty(o => o.Address);", "b.ComplexCollection(o => o.Lines, l => l.ToJson());"]},
    {"id": "EF-FROMSQL-INTERPOLATED", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\.(FromSqlInterpolated|ExecuteSqlInterpolated(Async)?)\\s*\\(",
     "message": "FromSqlInterpolated and ExecuteSqlInterpolated are the old names.",
     "fix": "Use FromSql and ExecuteSqlAsync. They do the same, with a shorter name.",
     "match": ["db.Users.FromSqlInterpolated($\"SELECT * FROM Users WHERE Id = {id}\")", "await db.Database.ExecuteSqlInterpolatedAsync($\"DELETE FROM T WHERE Id = {id}\");"],
     "nomatch": ["db.Users.FromSql($\"SELECT * FROM Users WHERE Id = {id}\")"]},
    {"id": "EF-MOCK-DBSET", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "(Mock|Substitute\\.For)\\s*<\\s*DbSet\\s*<",
     "message": "A mocked DbSet runs LINQ to Objects. It proves nothing about the SQL that EF makes.",
     "fix": "Test the query against the real engine in a container. See dev-stack:dotnet-testing.",
     "match": ["var set = new Mock<DbSet<Order>>();", "var orders = Substitute.For<DbSet<Order>, IQueryable<Order>>();"],
     "nomatch": ["var orders = Substitute.For<IOrderReader>();"]},
    {"id": "EF-PKG-LINQ-ASYNC", "kind": "package", "ecosystem": "nuget",
     "package": "System.Linq.Async", "versions": "*", "severity": "warning",
     "message": ".NET 10 has async LINQ in the base library. System.Linq.Async is not necessary and can conflict with it."},

    {"id": "DET-DATA-01", "kind": "detect", "decision": "DATA-01", "files": ["**/*.cs"],
     "pattern": "\\bUse(SqlServer|AzureSql|Npgsql)\\s*\\(",
     "match": ["options.UseNpgsql(cs);", "o.UseSqlServer(connectionString, sql => sql.UseCompatibilityLevel(170))"],
     "nomatch": ["options.UseSqlite(cs);"]},
    {"id": "DET-DATA-02", "kind": "detect", "decision": "DATA-02", "files": ["**/*.cs"],
     "pattern": "^\\s*using\\s+Dapper\\s*;",
     "match": ["using Dapper;"],
     "nomatch": ["using Microsoft.EntityFrameworkCore;"]},
    {"id": "DET-DATA-03", "kind": "detect", "decision": "DATA-03", "files": ["**/*.cs"],
     "pattern": "\\bclass\\s+\\w+(\\([^)]*\\))?\\s*:\\s*DbContext\\b",
     "match": ["public sealed class AppDbContext(DbContextOptions<AppDbContext> options) : DbContext(options)", "public class OrderingContext : DbContext"],
     "nomatch": ["public sealed class OrderQueries(AppDbContext db)"]},
    {"id": "DET-DATA-04", "kind": "detect", "decision": "DATA-04", "files": ["**/*.cs"],
     "pattern": "\\b(HasDefaultSchema|MigrationsHistoryTable)\\s*\\(",
     "match": ["modelBuilder.HasDefaultSchema(\"shipping\");", "o.MigrationsHistoryTable(\"__EFMigrationsHistory\", \"shipping\")"],
     "nomatch": ["modelBuilder.Entity<Order>().ToTable(\"Orders\");"]},
    {"id": "DET-DATA-05", "kind": "detect", "decision": "DATA-05", "files": ["**/*.cs"],
     "pattern": "\\bI(Read)?Repository\\s*<|\\bclass\\s+\\w*Repository\\s*<\\s*T\\w*\\s*>|\\busing\\s+Ardalis\\.Specification\\b",
     "match": ["public interface IRepository<T> where T : class", "public sealed class EfRepository<TEntity> : IRepository<TEntity>", "private readonly IReadRepository<Order> _orders;", "using Ardalis.Specification;"],
     "nomatch": ["public interface IOrderRepository", "public sealed class OrderRepository(AppDbContext db) : IOrderRepository"]},
    {"id": "DET-DATA-06", "kind": "detect", "decision": "DATA-06", "files": ["**/*.cs"],
     "pattern": "\\bIUnitOfWork\\b|\\bAutoApplyTransactions\\s*\\(",
     "match": ["public sealed class AppDbContext : DbContext, IUnitOfWork", "opts.Policies.AutoApplyTransactions();"],
     "nomatch": ["await db.SaveChangesAsync(ct);"]},
    {"id": "DET-DATA-07", "kind": "detect", "decision": "DATA-07", "files": ["**/*.cs"],
     "pattern": "\\bUseHiLo\\s*\\(|\\bUseIdentityColumn\\s*\\(|\\bId\\s*(\\{[^}\\n]*\\}\\s*)?=\\s*Guid\\.(NewGuid|CreateVersion7)\\s*\\(|\\bpublic\\s+(int|long|Guid)\\s+Id\\s*\\{",
     "match": ["modelBuilder.UseHiLo(\"orderseq\");", "public Guid Id { get; set; }", "public long Id { get; private set; }"],
     "nomatch": ["public Guid CustomerId { get; set; }", "public string Code { get; set; }"]},
    {"id": "DET-DATA-08", "kind": "detect", "decision": "DATA-08", "files": ["**/*.cs"],
     "pattern": "\\breadonly\\s+record\\s+struct\\s+\\w+Id\\s*\\(|\\[ValueObject(<[^>]+>)?\\]|\\[StronglyTypedId",
     "match": ["public readonly record struct OrderId(Guid Value);", "[ValueObject<Guid>]", "[StronglyTypedId]"],
     "nomatch": ["public sealed record Money(decimal Amount, string Currency);"]},
    {"id": "DET-DATA-09", "kind": "detect", "decision": "DATA-09", "files": ["**/*.cs"],
     "pattern": "\\bUse(SnakeCase|LowerCase|UpperSnakeCase|CamelCase)NamingConvention\\s*\\(",
     "match": ["options.UseNpgsql(cs).UseSnakeCaseNamingConvention();"],
     "nomatch": ["options.UseNpgsql(cs);"]},
    {"id": "DET-DATA-10", "kind": "detect", "decision": "DATA-10", "files": ["**/*.cs"],
     "pattern": "^\\s*using\\s+NodaTime\\s*;|\\bUseNodaTime\\s*\\(|\\bpublic\\s+DateTimeOffset\\??\\s+\\w+\\s*\\{",
     "match": ["using NodaTime;", "o.UseNodaTime()", "public DateTimeOffset CreatedAt { get; set; }"],
     "nomatch": ["public DateOnly DueDate { get; set; }"]},
    {"id": "DET-DATA-11", "kind": "detect", "decision": "DATA-11", "files": ["**/*.cs"],
     "pattern": "Properties<decimal\\??>\\s*\\(\\s*\\)\\s*\\.\\s*HavePrecision\\s*\\(|\\brecord\\s+Money\\s*\\(",
     "match": ["builder.Properties<decimal>().HavePrecision(18, 4);", "public sealed record Money(decimal Amount, string Currency);"],
     "nomatch": ["b.Property(p => p.Price).HasPrecision(19, 4);"]},
    {"id": "DET-DATA-12", "kind": "detect", "decision": "DATA-12", "files": ["**/*.cs"],
     "pattern": "\\bHa(ve|s)Conversion<string>\\s*\\(|\\bMapEnum<",
     "match": ["builder.Properties<OrderStatus>().HaveConversion<string>().HaveMaxLength(20);", "b.Property(o => o.Status).HasConversion<string>();", "o.MapEnum<Mood>(\"mood\")"],
     "nomatch": ["b.Property(o => o.Status).HasMaxLength(20);"]},
    {"id": "DET-DATA-13", "kind": "detect", "decision": "DATA-13", "files": ["**/*.cs"],
     "pattern": "\\bIsDeleted\\b|\\bHasQueryFilter\\s*\\(\\s*(\"SoftDelete\"|\\w+\\.SoftDelete)",
     "match": ["public bool IsDeleted { get; set; }", ".HasQueryFilter(\"SoftDelete\", o => !o.Removed)"],
     "nomatch": ["await db.Orders.Where(o => o.Id == id).ExecuteDeleteAsync(ct);"]},
    {"id": "DET-DATA-14", "kind": "detect", "decision": "DATA-14", "files": ["**/*.cs"],
     "pattern": "\\bSaveChangesInterceptor\\b|\\bpublic\\s+DateTimeOffset\\??\\s+(CreatedAt|UpdatedAt)\\b|\\busing\\s+Audit\\.EntityFramework\\b",
     "match": ["public sealed class AuditInterceptor(TimeProvider clock) : SaveChangesInterceptor", "public DateTimeOffset UpdatedAt { get; set; }"],
     "nomatch": ["public DateOnly DueDate { get; set; }"]},
    {"id": "DET-DATA-15", "kind": "detect", "decision": "DATA-15", "files": ["**/*.cs"],
     "pattern": "\\[Timestamp\\]|\\.IsRowVersion\\s*\\(|\\.IsConcurrencyToken\\s*\\(|\\[ConcurrencyCheck\\]",
     "match": ["[Timestamp]", "b.Property(o => o.Version).IsRowVersion();", "b.Property(o => o.Stamp).IsConcurrencyToken();"],
     "nomatch": ["b.Property(o => o.Reference).HasMaxLength(32);"]},
    {"id": "DET-DATA-16", "kind": "detect", "decision": "DATA-16", "files": ["**/*.cs"],
     "pattern": "\\bTenantId\\b|\\busing\\s+Finbuckle\\b",
     "match": ["public Guid TenantId { get; set; }", "using Finbuckle.MultiTenant;"],
     "nomatch": ["public Guid CustomerId { get; set; }"]},
    {"id": "DET-DATA-17", "kind": "detect", "decision": "DATA-17", "files": ["**/*.cs"],
     "pattern": "^\\s*using\\s+(DbUp|FluentMigrator)\\b|\\bpartial\\s+class\\s+\\w+\\s*:\\s*Migration\\b",
     "match": ["using DbUp;", "using FluentMigrator;", "public partial class Initial : Migration"],
     "nomatch": ["public sealed class OrderConfiguration : IEntityTypeConfiguration<Order>"]},
    {"id": "DET-DATA-18", "kind": "detect", "decision": "DATA-18",
     "files": ["**/*.cs", "**/*.yml", "**/*.yaml", "**/Dockerfile", "**/*.sh", "**/*.ps1"],
     "pattern": "\\bDatabase\\s*\\.\\s*Migrate(Async)?\\s*\\(|\\bef\\s+migrations\\s+(bundle|script)\\b|\\bPublishAsMigration(Bundle|Script)\\s*\\(|\\bAddEFMigrations\\b",
     "match": ["await db.Database.MigrateAsync(ct);", "run: dotnet ef migrations bundle --self-contained -r linux-x64", "dotnet ef migrations script --idempotent -o migrate.sql"],
     "nomatch": ["dotnet ef migrations add AddOrderReference", "dotnet ef migrations has-pending-model-changes"]},
    {"id": "DET-DATA-19", "kind": "detect", "decision": "DATA-19", "files": ["**/*.cs"],
     "pattern": "\\.HasData\\s*\\(|\\bUse(Async)?Seeding\\s*\\(|\\bIDbSeeder\\b",
     "match": ["modelBuilder.Entity<Country>().HasData(new Country { Id = 1 });", ".UseAsyncSeeding(async (context, _, ct) => { })"],
     "nomatch": ["db.Countries.Add(country);"]},
    {"id": "DET-DATA-21", "kind": "detect", "decision": "DATA-21", "files": ["**/*.cs"],
     "pattern": "\\.ToView\\s*\\(|\\.ToSqlQuery\\s*\\(|\\.HasNoKey\\s*\\(",
     "match": ["b.ToView(\"OrderSummaries\");", "b.HasNoKey();"],
     "nomatch": ["b.ToTable(\"Orders\");"]},
    {"id": "DET-DATA-22", "kind": "detect", "decision": "DATA-22", "files": ["**/*.cs"],
     "pattern": "\\bSqlBulkCopy\\b|\\bBeginBinaryImport(Async)?\\b|\\bBulk(Insert|Update|Merge|Delete|InsertOrUpdate)(Async)?\\s*\\(",
     "match": ["using var copy = new SqlBulkCopy(connection);", "await connection.BeginBinaryImportAsync(sql, ct);", "await db.BulkInsertAsync(rows);"],
     "nomatch": ["await db.Orders.Where(o => o.IsDeleted).ExecuteDeleteAsync(ct);"]}
  ]
}
