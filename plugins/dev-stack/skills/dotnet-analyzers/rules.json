{
  "skill": "dotnet-analyzers",
  "rules": [
    {"id": "ANA-PROPS-NULLABLE", "kind": "require", "severity": "warning",
     "files": ["Directory.Build.props"],
     "pattern": "<Nullable>\\s*enable\\s*</Nullable>",
     "message": "Turn on nullable reference types for all projects in the root Directory.Build.props.",
     "fix": "Add <Nullable>enable</Nullable>. In an existing repo, turn it on per project (references/adoption.md)."},
    {"id": "ANA-PROPS-ANALYSISLEVEL", "kind": "require", "severity": "warning",
     "files": ["Directory.Build.props"],
     "pattern": "<Analysis(Level|Mode)>",
     "message": "Set the analysis level, so that the build runs the recommended CA rules and not only the 92 of the default mode.",
     "fix": "Add <AnalysisLevel>latest-recommended</AnalysisLevel> (or 10-recommended). In an existing repo, report first."},
    {"id": "ANA-PROPS-CODESTYLE", "kind": "require", "severity": "warning",
     "files": ["Directory.Build.props"],
     "pattern": "<EnforceCodeStyleInBuild>\\s*true\\s*</EnforceCodeStyleInBuild>",
     "message": "IDE rules do not run in dotnet build without EnforceCodeStyleInBuild.",
     "fix": "Add <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>."},
    {"id": "ANA-PROPS-NULLABLE-ERRORS", "kind": "require", "severity": "warning",
     "files": ["Directory.Build.props"],
     "pattern": "<WarningsAsErrors>[^<]*\\bnullable\\b",
     "message": "Nullable warnings are bugs. Make them errors in each build.",
     "fix": "Add <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>."},
    {"id": "ANA-PROPS-DOCFILE", "kind": "require", "severity": "info",
     "files": ["Directory.Build.props"],
     "pattern": "<GenerateDocumentationFile>\\s*true\\s*</GenerateDocumentationFile>",
     "message": "IDE0005 (unused using) runs on build only with a documentation file.",
     "fix": "Add <GenerateDocumentationFile>true</GenerateDocumentationFile> and <NoWarn>$(NoWarn);CS1591</NoWarn>."},
    {"id": "ANA-PROPS-ERRORLOG", "kind": "require", "severity": "info",
     "files": ["Directory.Build.props"],
     "pattern": "<ErrorLog>",
     "message": "Without ErrorLog the compiler writes no SARIF file, and the agent loop can only read the build log.",
     "fix": "Add <ErrorLog>$(MSBuildProjectDirectory)/obj/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>."},

    {"id": "ANA-NOWARN", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<NoWarn>[^<]*\\b(CA|IDE|RCS|MA|VSTHRD|RS|MSTEST)\\d{3,4}",
     "message": "NoWarn hides an analyzer rule in the whole project and leaves no trace in SARIF.",
     "fix": "Fix the code. For a false positive, use #pragma warning disable <ID> // <reason> on the lines, or [SuppressMessage(..., Justification = \"...\")].",
     "match": ["<NoWarn>$(NoWarn);CA1822</NoWarn>", "    <NoWarn>CS1591;IDE0060;RCS1163</NoWarn>", "<NoWarn>$(NoWarn);VSTHRD200</NoWarn>"],
     "nomatch": ["<NoWarn>$(NoWarn);CS1591</NoWarn>", "<NoWarn>$(NoWarn);NU1603</NoWarn>", "<WarningsNotAsErrors>CA1822</WarningsNotAsErrors>"]},
    {"id": "ANA-PRAGMA-REASON", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["**/Migrations/**", "**/*.Designer.cs", "**/*.g.cs", "**/*.generated.cs"],
     "pattern": "^[ \\t]*#pragma[ \\t]+warning[ \\t]+disable\\b(?![^\\n]*//[ \\t]*\\S)",
     "message": "A #pragma warning disable needs a reason on the same line, so that a reviewer can check it.",
     "fix": "Fix the code, or write #pragma warning disable <ID> // <reason> and #pragma warning restore <ID> around the fewest lines.",
     "match": ["#pragma warning disable CA1822", "    #pragma warning disable CS8602, CS8604", "#pragma warning disable", "#pragma warning disable IDE0060 //"],
     "nomatch": ["#pragma warning disable CA1822 // The serializer needs an instance method.", "#pragma warning restore CA1822", "// #pragma warning disable is not allowed here"]},
    {"id": "ANA-SUPPRESS-JUSTIFICATION", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["**/*.g.cs", "**/*.generated.cs"],
     "pattern": "\\[\\s*(assembly:\\s*)?(System\\.Diagnostics\\.CodeAnalysis\\.)?SuppressMessage(Attribute)?\\((?![^\\n]*(Justification\\s*=\\s*\"[^\"\\s]|,\\s*$))",
     "message": "A SuppressMessage attribute needs a Justification, so that a reviewer can check the reason.",
     "fix": "Fix the code, or add Justification = \"<reason>\".",
     "match": ["[SuppressMessage(\"Performance\", \"CA1822:Mark members as static\")]", "[assembly: SuppressMessage(\"Style\", \"IDE0060\", Justification = \"\")]"],
     "nomatch": ["[SuppressMessage(\"Performance\", \"CA1822:Mark members as static\", Justification = \"The serializer needs an instance method.\")]", "[SuppressMessage(\"Performance\", \"CA1822:Mark members as static\",", "// SuppressMessage is not used here"]},
    {"id": "ANA-NULLABLE-OFF", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<Nullable>\\s*(disable|warnings|annotations)\\s*</Nullable>",
     "message": "Nullable reference types are off or only partly on in this project.",
     "fix": "Use <Nullable>enable</Nullable> and fix the warnings. For a large project, turn it on per file with #nullable enable first.",
     "match": ["<Nullable>disable</Nullable>", "    <Nullable>annotations</Nullable>"],
     "nomatch": ["<Nullable>enable</Nullable>", "<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>"]},
    {"id": "ANA-EDITORCONFIG-NULLABLE-OFF", "kind": "regex", "severity": "warning",
     "files": ["**/.editorconfig", "**/*.globalconfig"],
     "pattern": "dotnet_diagnostic\\.CS86\\d\\d\\.severity\\s*=\\s*(none|silent|suggestion)",
     "message": "A nullable warning is turned off in the configuration. Nullable warnings are bugs.",
     "fix": "Remove the line and fix the warnings.",
     "match": ["dotnet_diagnostic.CS8602.severity = none", "dotnet_diagnostic.CS8618.severity=suggestion"],
     "nomatch": ["dotnet_diagnostic.CS8602.severity = error", "dotnet_diagnostic.CA1822.severity = none"]},
    {"id": "ANA-RUNANALYZERS-OFF", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<(RunAnalyzers|RunAnalyzersDuringBuild|EnableNETAnalyzers)>\\s*false\\s*<",
     "message": "The analyzers are turned off, so the build checks nothing.",
     "fix": "Remove the property and fix the findings. For a generated project, give the reason in an XML comment.",
     "match": ["<RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>", "<RunAnalyzers>false</RunAnalyzers>", "<EnableNETAnalyzers>false</EnableNETAnalyzers>"],
     "nomatch": ["<RunAnalyzers>true</RunAnalyzers>", "<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>"]},
    {"id": "ANA-ROSLYNATOR-CATEGORY", "kind": "regex", "severity": "warning",
     "files": ["**/.editorconfig", "**/*.globalconfig"],
     "pattern": "dotnet_analyzer_diagnostic\\.category-roslynator\\.severity\\s*=\\s*(warning|error)",
     "message": "The Roslynator category severity also raises Hidden rules (RCS1141 and others) and gives much noise.",
     "fix": "Raise single rules: dotnet_diagnostic.RCS1075.severity = warning.",
     "match": ["dotnet_analyzer_diagnostic.category-roslynator.severity = warning"],
     "nomatch": ["dotnet_diagnostic.RCS1075.severity = warning", "dotnet_analyzer_diagnostic.category-roslynator.severity = none"]},
    {"id": "ANA-ANALYSIS-ALL", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<AnalysisLevel>[^<]*-all\\s*<|<AnalysisMode>\\s*All\\s*<",
     "message": "The All mode turns on 280 CA rules, with much noise (CA1062, CA2007, CA1515, CA2000, CA1031).",
     "fix": "Use <AnalysisLevel>latest-recommended</AnalysisLevel> and raise single rules in .editorconfig.",
     "match": ["<AnalysisLevel>latest-all</AnalysisLevel>", "<AnalysisMode>All</AnalysisMode>", "<AnalysisLevel>10-all</AnalysisLevel>"],
     "nomatch": ["<AnalysisLevel>latest-recommended</AnalysisLevel>", "<AnalysisMode>Recommended</AnalysisMode>"]},
    {"id": "ANA-RULESET", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<CodeAnalysisRuleSet>",
     "message": "Rule set files are legacy. Severities belong in .editorconfig.",
     "fix": "Move each rule to dotnet_diagnostic.<ID>.severity in .editorconfig and remove the rule set.",
     "match": ["<CodeAnalysisRuleSet>..\\\\rules.ruleset</CodeAnalysisRuleSet>"],
     "nomatch": ["<AnalysisLevel>latest-recommended</AnalysisLevel>"]},
    {"id": "ANA-ROSLYNATOR-OLDKEY", "kind": "regex", "severity": "warning",
     "files": ["**/.editorconfig", "**/*.globalconfig"],
     "pattern": "^\\s*roslynator\\.(max_line_length|prefix_field_identifier_with_underscore)\\b",
     "message": "Roslynator 5.0 removed this key. The setting has no effect.",
     "fix": "Use roslynator_max_line_length or roslynator_prefix_field_identifier_with_underscore.",
     "match": ["roslynator.max_line_length = 140"],
     "nomatch": ["roslynator_max_line_length = 140"]},

    {"id": "ANA-PKG-SONAR", "kind": "package", "ecosystem": "nuget", "package": "SonarAnalyzer.CSharp",
     "versions": "*", "severity": "warning",
     "message": "SonarAnalyzer.CSharp uses the SSALv1 license, which excludes the use of AI to analyze its output. Do not feed its findings to an agent without legal review."},
    {"id": "ANA-PKG-SECURITYCODESCAN", "kind": "package", "ecosystem": "nuget", "package": "SecurityCodeScan*",
     "versions": "*", "severity": "warning",
     "message": "SecurityCodeScan is not maintained since 2022. Use the CA security rules and CodeQL."},
    {"id": "ANA-PKG-STYLECOP", "kind": "package", "ecosystem": "nuget", "package": "StyleCop.Analyzers*",
     "versions": "*", "severity": "info",
     "message": "StyleCop.Analyzers has only beta releases for modern C#, and many rules overlap IDE rules and dotnet format. Keep it only as a team decision."},
    {"id": "ANA-PKG-NETANALYZERS", "kind": "package", "ecosystem": "nuget", "package": "Microsoft.CodeAnalysis.NetAnalyzers",
     "versions": "*", "severity": "warning",
     "message": "The .NET SDK ships the analyzers. Remove the package and set AnalysisLevel."},
    {"id": "ANA-PKG-FXCOP", "kind": "package", "ecosystem": "nuget", "package": "Microsoft.CodeAnalysis.FxCopAnalyzers",
     "versions": "*", "severity": "warning",
     "message": "FxCopAnalyzers is deprecated. Remove it and set AnalysisLevel."},

    {"id": "ANA-DET-QUAL-04", "kind": "detect", "decision": "QUAL-04",
     "files": [".editorconfig"],
     "pattern": "^\\s*root\\s*=\\s*true",
     "match": ["root = true"], "nomatch": ["# root = true is set in the parent folder"]},
    {"id": "ANA-DET-QUAL-11", "kind": "detect", "decision": "QUAL-11",
     "files": ["**/Directory.Packages.props"],
     "pattern": "<ManagePackageVersionsCentrally>\\s*true",
     "match": ["<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>"],
     "nomatch": ["<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>"]},
    {"id": "ANA-DET-QUAL-01", "kind": "detect", "decision": "QUAL-01",
     "files": ["**/*.csproj", "**/*.props"],
     "pattern": "<(AnalysisLevel|AnalysisMode|TreatWarningsAsErrors)\\b",
     "match": ["<AnalysisLevel>latest-recommended</AnalysisLevel>", "<TreatWarningsAsErrors Condition=\"'$(CI)' == 'true'\">true</TreatWarningsAsErrors>"],
     "nomatch": ["<Nullable>enable</Nullable>"]},
    {"id": "ANA-DET-QUAL-02", "kind": "detect", "decision": "QUAL-02",
     "files": ["**/*.csproj", "**/*.props"],
     "pattern": "Include=\"(Roslynator\\.Analyzers|Meziantou\\.Analyzer|Microsoft\\.VisualStudio\\.Threading\\.Analyzers|StyleCop\\.Analyzers|SonarAnalyzer\\.CSharp|AsyncFixer)\"",
     "match": ["<GlobalPackageReference Include=\"Roslynator.Analyzers\" Version=\"5.0.1\" />"],
     "nomatch": ["<PackageReference Include=\"Microsoft.Extensions.Logging\" />"]},
    {"id": "ANA-DET-QUAL-03", "kind": "detect", "decision": "QUAL-03",
     "files": [".github/workflows/*.yml", ".github/workflows/*.yaml", "**/azure-pipelines*.yml", "**/.gitlab-ci.yml", "**/.csharpierrc*", "**/.config/dotnet-tools.json"],
     "pattern": "dotnet format\\b[^\\n]*--verify-no-changes|csharpier",
     "match": ["      - run: dotnet format --verify-no-changes --no-restore", "\"csharpier\": {"],
     "nomatch": ["      - run: dotnet build -warnaserror"]},
    {"id": "ANA-DET-QUAL-05", "kind": "detect", "decision": "QUAL-05",
     "files": ["**/*.csproj", "**/*.props"],
     "pattern": "BannedSymbols\\.txt|Microsoft\\.CodeAnalysis\\.BannedApiAnalyzers",
     "match": ["<AdditionalFiles Include=\"$(MSBuildThisFileDirectory)BannedSymbols.txt\" />"],
     "nomatch": ["<AdditionalFiles Include=\"stylecop.json\" />"]},
    {"id": "ANA-DET-QUAL-10", "kind": "detect", "decision": "QUAL-10",
     "files": ["lefthook.yml", "lefthook.yaml", ".husky/*", "package.json", ".config/dotnet-tools.json"],
     "pattern": "\\b(husky|lefthook|lint-staged)\\b",
     "match": ["    \"husky\": \"^9.1.7\",", "pre-commit: lefthook run"],
     "nomatch": ["    \"prettier\": \"^3.6.2\","]}
  ]
}
