      "id": "ASP-DET-CFG-07",
      "kind": "detect",
      "decision": "CFG-07",
      "files": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.props"
      ],
      "pattern": ":\\s*BackgroundService\\b|Include=\"(Hangfire|Quartz|TickerQ)[\\w.]*\"",
      "match": [
        "public sealed class OutboxPublisher(IServiceScopeFactory scopes) : BackgroundService",
        "<PackageVersion Include=\"Hangfire.Core\" Version=\"1.8.25\" />"
      ],
      "nomatch": [
        "builder.Services.AddHostedService<OutboxPublisher>();"
      ]
    },
    {
      "id": "ASP-DET-CFG-08",
