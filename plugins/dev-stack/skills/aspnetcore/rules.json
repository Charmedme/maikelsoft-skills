      "id": "ASP-DET-API-14",
      "kind": "detect",
      "decision": "API-14",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**"
      ],
      "pattern": "\\.AddRateLimiter\\s*\\(",
      "match": [
        "builder.Services.AddRateLimiter(options =>"
      ],
      "nomatch": [
        "app.UseRouting();"
      ]
    },
