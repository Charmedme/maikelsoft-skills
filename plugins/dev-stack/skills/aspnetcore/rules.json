      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**"
      ],
      "pattern": "\\.AddOptions(WithValidateOnStart)?<",
