      "id": "ASP-DET-CFG-05",
      "kind": "detect",
      "decision": "CFG-05",
      "files": [
        "**/*.cs"
      ],
      "exclude": [
        "tests/**",
        "test/**",
        "**/*Tests/**",
        "**/*Test/**"
      ],
