    {
      "id": "ASP-DET-CFG-03",
      "kind": "detect",
      "decision": "CFG-03",
      "files": [
        "**/*.csproj",
        "**/*.props"
      ],
      "pattern": "Include=\"(Microsoft\\.FeatureManagement|OpenFeature)[\\w.]*\"",
