{
  "skill": "dotnet-11",
  "rules": [
    {"id": "N11-PREVIEW-SDK", "kind": "regex", "severity": "error",
     "files": ["**/global.json"],
     "pattern": "\"version\"\\s*:\\s*\"11\\.0\\.\\d+-(preview|rc)",
     "message": ".NET 11 is GA since 2026-11-10. A preview or RC SDK pin is stale, and old guidance (the Microsoft skill migrate-dotnet10-to-dotnet11) still writes it.",
     "fix": "Set \"version\": \"11.0.100\" (or a later GA SDK) with \"rollForward\": \"latestFeature\" and \"allowPrerelease\": false.",
     "match": ["    \"version\": \"11.0.100-preview.3\",", "  \"version\":\"11.0.100-rc.3.26522.148\""],
     "nomatch": ["    \"version\": \"11.0.100\",", "    \"version\": \"10.0.404\","]},
    {"id": "N11-PREVIEW-FLAGS", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/Directory.*.props"],
     "pattern": "<EnablePreviewFeatures>\\s*true|<LangVersion>\\s*(preview|15)\\b",
     "message": "Runtime async and C# 15 need no preview flag on the GA SDK. EnablePreviewFeatures or LangVersion preview turns on preview features that can change.",
     "fix": "Remove EnablePreviewFeatures and LangVersion. For runtime async, use <Features>runtime-async=on</Features> after decision NET-02.",
     "match": ["    <EnablePreviewFeatures>true</EnablePreviewFeatures>", "    <LangVersion>preview</LangVersion>", "    <LangVersion>15</LangVersion>"],
     "nomatch": ["    <Features>runtime-async=on</Features>", "    <EnablePreviewFeatures>false</EnablePreviewFeatures>", "    <LangVersion>14</LangVersion>"]},
    {"id": "N11-CONCURRENCY-LIMITER", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "\\bUseConcurrencyLimiter\\s*\\(|\\b[Ss]ervices\\s*\\.\\s*AddConcurrencyLimiter\\s*\\(",
     "message": "ASP.NET Core 11 removed the ConcurrencyLimiter middleware. The build gives CS1061.",
     "fix": "Use AddRateLimiter with RateLimitPartition.GetConcurrencyLimiter, and app.UseRateLimiter().",
     "match": ["app.UseConcurrencyLimiter();", "builder.Services.AddConcurrencyLimiter(o => o.MaxConcurrentRequests = 100);", "services.AddConcurrencyLimiter(options => { });"],
     "nomatch": ["    options.AddConcurrencyLimiter(\"orders\", o => o.PermitLimit = 10);", "app.UseRateLimiter();", "RateLimitPartition.GetConcurrencyLimiter(\"all\", _ => new ConcurrencyLimiterOptions())"]},
    {"id": "N11-EF-OPTIMIZE", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/Directory.*.props"],
     "pattern": "<EFOptimizeContext\\b",
     "message": "EF Core 11 removed the EFOptimizeContext property. The build ignores it, so the compiled model or the precompiled queries stop without an error.",
     "fix": "Use EFScaffoldModelStage and EFPrecompileQueriesStage.",
     "match": ["    <EFOptimizeContext>true</EFOptimizeContext>"],
     "nomatch": ["    <EFScaffoldModelStage>build</EFScaffoldModelStage>", "    <EFPrecompileQueriesStage>build</EFPrecompileQueriesStage>"]},
    {"id": "N11-OLD-TFM", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/Directory.*.props"],
     "pattern": "<TargetFrameworks?>[^<]*\\bnet(5|6|7|8|9)\\.0\\b",
     "message": "net8.0 and net9.0 are out of support since 2026-11-10. Earlier versions are out of support too.",
     "fix": "Tell the human. Move to net10.0 (LTS), or to net11.0 after decision NET-01.",
     "match": ["    <TargetFramework>net8.0</TargetFramework>", "    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>"],
     "nomatch": ["    <TargetFramework>net10.0</TargetFramework>", "    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>"]},

    {"id": "N11-DET-NET-01", "kind": "detect", "decision": "NET-01",
     "files": ["**/*.csproj", "**/Directory.*.props"],
     "pattern": "<TargetFrameworks?>[^<]*\\bnet11\\.0\\b",
     "match": ["    <TargetFramework>net11.0</TargetFramework>"],
     "nomatch": ["    <TargetFramework>net10.0</TargetFramework>"]},
    {"id": "N11-DET-NET-02", "kind": "detect", "decision": "NET-02",
     "files": ["**/*.csproj", "**/Directory.*.props"],
     "pattern": "runtime-async\\s*=\\s*on|<UseRuntimeAsync>",
     "match": ["    <Features>runtime-async=on</Features>", "    <UseRuntimeAsync>false</UseRuntimeAsync>"],
     "nomatch": ["    <Features>strict</Features>"]},
    {"id": "N11-DET-NET-03", "kind": "detect", "decision": "NET-03",
     "files": ["**/*.csproj", "**/Directory.*.props"],
     "pattern": "<TargetFrameworks>[^<]*\\bnet10\\.0;net11\\.0\\b",
     "match": ["    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>"],
     "nomatch": ["    <TargetFramework>net11.0</TargetFramework>"]}
  ]
}
