{
  "skill": "csharp",
  "rules": [
    {"id": "CS-PKG-MEDIATR", "kind": "package", "ecosystem": "nuget", "package": "MediatR*", "versions": "*",
     "severity": "error",
     "message": "MediatR is not allowed. Call a handler class directly. When the human approves a mediator, use Mediator (martinothamar, MIT) or Wolverine.",
     "fix": "Remove the package. Inject the handler class and call it."},
    {"id": "CS-PKG-AUTOMAPPER", "kind": "package", "ecosystem": "nuget", "package": "AutoMapper*", "versions": "*",
     "severity": "error",
     "message": "AutoMapper is not allowed. Write the mapping by hand. For large mappings, use Mapperly (source generator, Apache-2.0).",
     "fix": "Remove the package. Add a static ToDto method or a Mapperly mapper."},
    {"id": "CS-PKG-LINQ-ASYNC", "kind": "package", "ecosystem": "nuget", "package": "System.Linq.Async", "versions": "*",
     "severity": "warning",
     "message": "On net10.0 the core libraries give LINQ for IAsyncEnumerable (System.Linq.AsyncEnumerable). Versions before 7 conflict with it.",
     "fix": "Remove the package when the project targets net10.0 or later only."},

    {"id": "CS-ASYNC-VOID", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "\\basync\\s+void\\s+\\w+\\s*\\((?![^)]*EventArgs\\b)",
     "message": "async void crashes the process when the method throws, and the caller cannot await it. Only event handlers can be async void.",
     "fix": "Return Task and await the call.",
     "match": ["public async void Refresh()", "private async void SaveAsync(Order order)"],
     "nomatch": ["public async Task RefreshAsync(CancellationToken ct)", "private async void OnClick(object? sender, EventArgs e)", "async void Button_Click(object sender, RoutedEventArgs e)"]},
    {"id": "CS-GETRESULT", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "\\.GetAwaiter\\(\\)\\s*\\.GetResult\\(\\)",
     "message": "Blocking on a task (sync over async) starves the thread pool and can deadlock.",
     "fix": "Make the caller async and await the task.",
     "match": ["var order = store.FindAsync(id, ct).GetAwaiter().GetResult();"],
     "nomatch": ["var order = await store.FindAsync(id, ct);"]},
    {"id": "CS-TASK-BLOCK", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "(?:Async\\([^()]*\\)|\\b\\w*[Tt]ask\\w*)\\.(?:Result\\b(?!\\s*=[^=])|Wait\\()|\\bTask\\.Wait(?:All|Any)\\(",
     "message": "Task.Result, Task.Wait(), Task.WaitAll and Task.WaitAny block a thread (sync over async).",
     "fix": "Await the task, or use Task.WhenAll or Task.WhenAny.",
     "match": ["var order = store.FindAsync(id, ct).Result;", "loadTask.Wait();", "Task.WaitAll(first, second);", "return task.Result;"],
     "nomatch": ["var order = await store.FindAsync(id, ct);", "var outcome = validation.Result;", "await Task.WhenAll(first, second);", "operation.Result = value;"]},
    {"id": "CS-CLOCK", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests*/**", "**/*Test/**", "**/*Tests.cs", "**/Migrations/**"],
     "pattern": "\\bDateTime(?:Offset)?\\.(?:UtcNow|Now)\\b|\\bDateTime\\.Today\\b",
     "message": "Read the time from TimeProvider, so that tests can control it (decision CFG-04).",
     "fix": "Inject TimeProvider and call GetUtcNow(). Register TimeProvider.System in the host.",
     "match": ["var now = DateTime.UtcNow;", "order.CreatedAt = DateTimeOffset.Now;", "if (DateTime.Today > due)"],
     "nomatch": ["var now = time.GetUtcNow();", "DateTimeOffset createdAt = order.CreatedAt;"]},
    {"id": "CS-THREAD-SLEEP", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["tests/**", "test/**", "**/*Tests*/**", "**/*Test/**", "**/*Tests.cs"],
     "pattern": "\\bThread\\.Sleep\\(",
     "message": "Thread.Sleep blocks a thread, and tests cannot skip the wait.",
     "fix": "Use await Task.Delay(delay, timeProvider, cancellationToken) or a PeriodicTimer with TimeProvider.",
     "match": ["Thread.Sleep(1000);", "System.Threading.Thread.Sleep(TimeSpan.FromSeconds(1));"],
     "nomatch": ["await Task.Delay(TimeSpan.FromSeconds(1), time, cancellationToken);"]},
    {"id": "CS-TCS-OPTIONS", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "new\\s+TaskCompletionSource(?:<[^>]+>)?\\(\\s*\\)",
     "message": "A TaskCompletionSource without RunContinuationsAsynchronously runs the code after await inside SetResult. This can deadlock.",
     "fix": "new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously)",
     "match": ["var done = new TaskCompletionSource();", "private readonly TaskCompletionSource<int> _result = new TaskCompletionSource<int>();"],
     "nomatch": ["var done = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);"]},
    {"id": "CS-NULLABLE-DISABLE", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "exclude": ["**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs", "**/*.generated.cs"],
     "pattern": "^\\s*#nullable\\s+disable\\b",
     "message": "#nullable disable hides null bugs. Keep nullable reference types on in all code that people write.",
     "fix": "Remove the directive and fix the warnings. Add ? to members that can be null.",
     "match": ["#nullable disable", "  #nullable disable warnings"],
     "nomatch": ["#nullable enable", "#nullable restore"]},
    {"id": "CS-PRAGMA-NO-REASON", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["**/Migrations/**", "**/*.g.cs", "**/*.Designer.cs", "**/*.generated.cs"],
     "pattern": "^\\s*#pragma\\s+warning\\s+disable\\b(?!.*//\\s*\\S)",
     "message": "A suppression needs the rule ID and a reason on the same line, so that a reviewer can check it.",
     "fix": "#pragma warning disable CA1062 // reason, and #pragma warning restore CA1062 after the line.",
     "match": ["#pragma warning disable CA2007", "#pragma warning disable", "#pragma warning disable CS8618 //"],
     "nomatch": ["#pragma warning disable CA1859 // the interface is the public contract", "#pragma warning restore CA1859"]},
    {"id": "CS-LANGVERSION", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<LangVersion\\b",
     "message": "The SDK picks the C# version from the target framework. An explicit LangVersion (latest, preview) can turn on preview features or an unsupported version.",
     "fix": "Remove LangVersion. Change TargetFramework to get a newer C# version.",
     "match": ["    <LangVersion>latest</LangVersion>", "<LangVersion>preview</LangVersion>"],
     "nomatch": ["    <TargetFramework>net10.0</TargetFramework>"]},
    {"id": "CS-FLOATING-VERSION", "kind": "regex", "severity": "warning",
     "files": ["**/*.csproj", "**/*.props", "**/*.targets"],
     "pattern": "<Package(?:Reference|Version)\\b[^>]*\\bVersion=\"[^\"]*\\*",
     "message": "A floating version gives a different package on each restore. Builds are not repeatable.",
     "fix": "Use an exact version in Directory.Packages.props.",
     "match": ["<PackageVersion Include=\"Polly.Core\" Version=\"8.*\" />", "<PackageReference Include=\"Serilog\" Version=\"4.0.*\" />"],
     "nomatch": ["<PackageVersion Include=\"Polly.Core\" Version=\"8.8.0\" />"]},
    {"id": "CS-PROPS-NULLABLE", "kind": "require", "severity": "warning",
     "files": ["Directory.Build.props"],
     "pattern": "<Nullable>\\s*enable\\s*</Nullable>",
     "message": "Turn on nullable reference types for all projects in the root Directory.Build.props (decision SOL-03).",
     "fix": "Add <Nullable>enable</Nullable> to the PropertyGroup."},

    {"id": "CS-DET-SOL-01", "kind": "detect", "decision": "SOL-01",
     "files": ["**/*.sln", "**/*.slnx"],
     "pattern": "[\\w.]+\\.(?:Domain|Application|Infrastructure)\\.csproj",
     "match": ["  <Project Path=\"src/Shop.Domain/Shop.Domain.csproj\" />", "Project(\"{FAE04EC0}\") = \"Shop.Application\", \"src\\Shop.Application\\Shop.Application.csproj\""],
     "nomatch": ["  <Project Path=\"src/Shop.Api/Shop.Api.csproj\" />"]},
    {"id": "CS-DET-SOL-02-FEATURE", "kind": "detect", "decision": "SOL-02",
     "files": ["**/*.cs"],
     "pattern": "^\\s*namespace\\s+[\\w.]+\\.(?:Features|Modules|Slices)\\b",
     "match": ["namespace Shop.Api.Features.Orders;"],
     "nomatch": ["namespace Shop.Api.Services;"]},
    {"id": "CS-DET-SOL-02-TYPE", "kind": "detect", "decision": "SOL-02",
     "files": ["**/*.cs"],
     "pattern": "^\\s*namespace\\s+[\\w.]+\\.(?:Services|Controllers|Repositories|Models|Dtos|Helpers)\\s*[;{]",
     "match": ["namespace Shop.Api.Services;", "namespace Shop.Api.Controllers {"],
     "nomatch": ["namespace Shop.Api.Features.Orders;"]},
    {"id": "CS-DET-SOL-03", "kind": "detect", "decision": "SOL-03",
     "files": ["**/Directory.Build.props"],
     "pattern": "<(?:TargetFramework|Nullable|ImplicitUsings|AnalysisLevel)>",
     "match": ["    <Nullable>enable</Nullable>"],
     "nomatch": ["    <Authors>Team</Authors>"]},
    {"id": "CS-DET-SOL-04", "kind": "detect", "decision": "SOL-04",
     "files": ["**/Directory.Packages.props", "**/Directory.Build.props"],
     "pattern": "<ManagePackageVersionsCentrally>\\s*true",
     "match": ["    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>"],
     "nomatch": ["    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>"]},
    {"id": "CS-DET-SOL-05", "kind": "detect", "decision": "SOL-05",
     "files": ["**/global.json"],
     "pattern": "\"rollForward\"\\s*:|\"sdk\"\\s*:",
     "match": ["  \"sdk\": {", "    \"rollForward\": \"latestFeature\","],
     "nomatch": ["  \"msbuild-sdks\": {"]},
    {"id": "CS-DET-SOL-06", "kind": "detect", "decision": "SOL-06",
     "files": ["**/*.csproj", "**/*.props"],
     "pattern": "<(?:TreatWarningsAsErrors|WarningsAsErrors)\\b",
     "match": ["    <TreatWarningsAsErrors Condition=\"'$(CI)' == 'true'\">true</TreatWarningsAsErrors>", "<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>"],
     "nomatch": ["<WarningsNotAsErrors>NU1901</WarningsNotAsErrors>", "<NoWarn>$(NoWarn);CS1591</NoWarn>"]},
    {"id": "CS-DET-SOL-07", "kind": "detect", "decision": "SOL-07",
     "files": ["**/.editorconfig"],
     "pattern": "^\\s*(?:csharp_style_|dotnet_diagnostic\\.|dotnet_naming_)",
     "match": ["csharp_style_namespace_declarations = file_scoped:warning", "dotnet_diagnostic.IDE0005.severity = warning"],
     "nomatch": ["indent_size = 4"]},
    {"id": "CS-DET-SOL-08", "kind": "detect", "decision": "SOL-08",
     "files": ["**/*.cs"],
     "pattern": "^\\s*private\\s+(?:static\\s+)?(?:readonly\\s+)?[\\w<>,.?\\[\\] ]+?\\s+(?:_|s_)[a-z]\\w*\\s*[=;]",
     "match": ["    private readonly Dictionary<Guid, Order> _orders = [];", "    private static readonly HttpClient s_client = new();"],
     "nomatch": ["    private readonly IOrderStore store;", "    public string Name { get; init; }"]},
    {"id": "CS-DET-SOL-09", "kind": "detect", "decision": "SOL-09",
     "files": ["**/*.cs"],
     "pattern": "\\binterface\\s+I[A-Z]\\w*Service\\b",
     "match": ["public interface IOrderService"],
     "nomatch": ["public interface IOrderStore", "public sealed class OrderService(IOrderStore store)"]},
    {"id": "CS-DET-CFG-04", "kind": "detect", "decision": "CFG-04",
     "files": ["**/*.cs"],
     "pattern": "\\bTimeProvider\\b",
     "match": ["public sealed class OrderService(IOrderStore store, TimeProvider time)"],
     "nomatch": ["var now = DateTime.UtcNow;"]}
  ]
}
