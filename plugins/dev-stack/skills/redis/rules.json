{
  "skill": "redis",
  "rules": [
    {"id": "RDS-MUX-CONNECT", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "exclude": ["**/Program.cs", "**/*Extensions.cs", "tests/**", "test/**", "**/*Tests/**", "**/*Test/**", "**/*Tests.cs", "**/*Test.cs", "**/*Fixture.cs"],
     "pattern": "\\bConnectionMultiplexer\\s*\\.\\s*Connect(Async)?\\s*\\(",
     "message": "A multiplexer made outside startup is a new connection for each call or each scope. It uses up sockets and is slow.",
     "fix": "Connect one time at startup with ConnectAsync, register the IConnectionMultiplexer as a singleton, and inject it.",
     "match": ["using var redis = ConnectionMultiplexer.Connect(\"localhost:6379\");", "var mux = await ConnectionMultiplexer.ConnectAsync(options);"],
     "nomatch": ["builder.Services.AddSingleton<IConnectionMultiplexer>(mux);", "var db = multiplexer.GetDatabase();"]},
    {"id": "RDS-KEYS-SCAN", "kind": "regex", "severity": "error",
     "files": ["**/*.cs"],
     "pattern": "(\\b\\w*[Ss]erver\\w*|GetServer\\s*\\([^)\\n]*\\))\\s*\\.\\s*Keys(Async)?\\s*\\(|\\.\\s*Execute(Async)?\\s*\\(\\s*\"KEYS\"",
     "message": "KEYS and server.Keys read the whole key space. KEYS blocks the server, and a scan is not an atomic delete.",
     "fix": "Use tags (RemoveByTagAsync) for HybridCache values, or a new version segment in the key so old keys expire by TTL.",
     "match": ["foreach (var key in server.Keys(pattern: \"orders:*\"))", "await db.ExecuteAsync(\"KEYS\", \"orders:*\");", "var keys = mux.GetServer(endpoint).Keys(pattern: \"price:*\");"],
     "nomatch": ["foreach (var key in dictionary.Keys)", "var keys = serverOptions.Keys;"]},
    {"id": "RDS-ABORT-CONNECT", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs", "**/appsettings*.json"],
     "pattern": "\\bAbortOnConnectFail\\s*=\\s*true\\b|abortConnect\\s*=\\s*true",
     "message": "With abortConnect=true the app does not start when the cache server is down for a moment.",
     "fix": "Set AbortOnConnectFail = false (or abortConnect=false). The multiplexer then connects in the background.",
     "match": ["options.AbortOnConnectFail = true;", "\"Cache\": \"localhost:6379,abortConnect=true\""],
     "nomatch": ["options.AbortOnConnectFail = false;", "\"Cache\": \"localhost:6379,abortConnect=false\""]},
    {"id": "RDS-MIN-THREADS", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bThreadPool\\s*\\.\\s*SetMinThreads\\s*\\(",
     "message": "SetMinThreads hides thread pool starvation from sync over async. The next load spike times out again.",
     "fix": "Remove the blocking calls (SER307, SER308) and await each Redis call.",
     "match": ["ThreadPool.SetMinThreads(200, 200);", "System.Threading.ThreadPool.SetMinThreads(workerThreads: 100, completionPortThreads: 100);"],
     "nomatch": ["ThreadPool.GetMinThreads(out var w, out var io);", "var v = await db.StringGetAsync(key);"]},
    {"id": "RDS-KEY-DELETE-LOCK", "kind": "regex", "severity": "warning",
     "files": ["**/*.cs"],
     "pattern": "\\bKeyDelete(Async)?\\s*\\(\\s*[^,)\\n]*[Ll]ock",
     "message": "KeyDelete releases the lock of another holder after your lock expired.",
     "fix": "Release with LockReleaseAsync(key, token). It deletes the key only when the token is still yours.",
     "match": ["await db.KeyDeleteAsync(lockKey);", "db.KeyDelete($\"lock:{resource}\");"],
     "nomatch": ["await db.LockReleaseAsync(lockKey, token);", "await db.KeyDeleteAsync($\"orders:v1:product:{id}\");"]},
    {"id": "RDS-PKG-OLD", "kind": "package", "ecosystem": "nuget",
     "package": "Microsoft.Extensions.Caching.Redis", "versions": "*", "severity": "warning",
     "message": "Microsoft.Extensions.Caching.Redis is the old package (2.x, StackExchange.Redis.StrongName).",
     "fix": "Use Microsoft.Extensions.Caching.StackExchangeRedis with a direct StackExchange.Redis 3.x reference."},
    {"id": "RDS-PKG-SER2", "kind": "package", "ecosystem": "nuget",
     "package": "StackExchange.Redis", "versions": "<3.0.0", "severity": "warning",
     "message": "StackExchange.Redis 2.x is the old line. The SER305 to SER308 analyzers ship only with 3.x, so .editorconfig lines for them do nothing on 2.x.",
     "fix": "Reference StackExchange.Redis 3.x (3.4.20 on 2026-10-25), or a PackageVersion 3.x with CentralPackageTransitivePinningEnabled."},
    {"id": "RDS-PKG-REDLOCK", "kind": "package", "ecosystem": "nuget",
     "package": "RedLock.net", "versions": "*", "severity": "warning",
     "message": "RedLock is not safe under GC pauses, clock drift, and failovers (decision CACHE-08).",
     "fix": "Use LockTakeAsync with a token for short work, or DistributedLock.Redis. Protect correctness with a database constraint."},

    {"id": "DET-CACHE-01", "kind": "detect", "decision": "CACHE-01", "files": ["**/*.cs"],
     "pattern": "\\bAdd(Hybrid|Memory|StackExchangeRedis|FusionCache|DistributedMemory)Cache\\b",
     "match": ["builder.Services.AddHybridCache();", "services.AddMemoryCache();", "builder.Services.AddStackExchangeRedisCache(o => o.InstanceName = \"orders:\");"],
     "nomatch": ["builder.Services.AddOutputCache();", "builder.Services.AddResponseCaching();"]},
    {"id": "DET-CACHE-02", "kind": "detect", "decision": "CACHE-02",
     "files": ["**/*compose*.yml", "**/*compose*.yaml", "**/*.cs"],
     "pattern": "image:\\s*[\"']?(valkey/valkey|redis)\\b|\\bnew\\s+RedisBuilder\\s*\\(|\\bAddRedis\\s*\\(\\s*\"",
     "match": ["    image: valkey/valkey:9.1", "    image: \"redis:8.2\"", "s_valkey = new RedisBuilder(\"valkey/valkey:9.1\").Build();"],
     "nomatch": ["    image: postgres:18.6-alpine", "    image: rabbitmq:4.3-management-alpine"]},
    {"id": "DET-CACHE-03", "kind": "detect", "decision": "CACHE-03", "files": ["**/*.cs"],
     "pattern": "\\bInstanceName\\s*=",
     "match": ["    options.InstanceName = \"orders:\";"],
     "nomatch": ["    options.ClientName = \"orders-api\";"]},
    {"id": "DET-CACHE-04", "kind": "detect", "decision": "CACHE-04", "files": ["**/*.cs"],
     "pattern": "\\bLocalCacheExpiration\\s*=|\\bDefaultEntryOptions\\s*=",
     "match": ["        LocalCacheExpiration = TimeSpan.FromMinutes(1),", "    options.DefaultEntryOptions = new HybridCacheEntryOptions"],
     "nomatch": ["        Expiration = TimeSpan.FromMinutes(5),"]},
    {"id": "DET-CACHE-05", "kind": "detect", "decision": "CACHE-05", "files": ["**/*.cs"],
     "pattern": "\\bRemoveByTag(s)?Async\\s*\\(",
     "match": ["await cache.RemoveByTagAsync($\"tenant:{tenantId}\", ct);"],
     "nomatch": ["await cache.RemoveAsync(key, ct);", "    .AddCheck<DatabaseHealthCheck>(\"database\", tags: [\"ready\"]);"]},
    {"id": "DET-CACHE-06", "kind": "detect", "decision": "CACHE-06", "files": ["**/*.cs"],
     "pattern": "\\bAddSerializer(Factory)?\\s*<|AddKeyedSingleton\\s*<\\s*JsonSerializerOptions\\s*>",
     "match": ["builder.Services.AddHybridCache().AddSerializer<OrderDto, OrderSerializer>();", "builder.Services.AddKeyedSingleton<JsonSerializerOptions>("],
     "nomatch": ["builder.Services.AddSingleton(new JsonSerializerOptions());"]},
    {"id": "DET-CACHE-07", "kind": "detect", "decision": "CACHE-07", "files": ["**/*.cs"],
     "pattern": "HybridCacheEntryFlags\\s*\\.\\s*DisableLocalCache\\b|\\bWithBackplane\\s*\\(|\\bAddFusionCache\\s*\\(",
     "match": ["    Flags = HybridCacheEntryFlags.DisableLocalCache,", "    .WithBackplane(new RedisBackplane(backplaneOptions))"],
     "nomatch": ["    Flags = HybridCacheEntryFlags.DisableLocalCacheRead,", "    LocalCacheExpiration = TimeSpan.FromMinutes(1),"]},
    {"id": "DET-CACHE-08", "kind": "detect", "decision": "CACHE-08", "files": ["**/*.cs"],
     "pattern": "\\bLockTake(Async)?\\s*\\(|\\bnew\\s+RedisDistributedLock\\s*\\(|^\\s*using\\s+RedLockNet\\b",
     "match": ["if (!await db.LockTakeAsync(key, token, TimeSpan.FromMinutes(2)))", "var exportLock = new RedisDistributedLock(\"export\", database);", "using RedLockNet.SERedis;"],
     "nomatch": ["await db.LockReleaseAsync(key, token);"]}
  ]
}
