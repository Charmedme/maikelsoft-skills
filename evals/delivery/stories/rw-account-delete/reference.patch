diff --git a/src/Conduit/Features/Users/Delete.cs b/src/Conduit/Features/Users/Delete.cs
new file mode 100644
index 0000000..f941cbc
--- /dev/null
+++ b/src/Conduit/Features/Users/Delete.cs
@@ -0,0 +1,100 @@
+using System.Linq;
+using System.Net;
+using System.Threading;
+using System.Threading.Tasks;
+using Conduit.Infrastructure;
+using Conduit.Infrastructure.Errors;
+using Conduit.Infrastructure.Security;
+using FluentValidation;
+using Mediator;
+using Microsoft.AspNetCore.Identity;
+using Microsoft.EntityFrameworkCore;
+
+namespace Conduit.Features.Users;
+
+public class Delete
+{
+    public class UserData
+    {
+        public string? Password { get; init; }
+    }
+
+    public record Command(UserData User) : IRequest;
+
+    public class CommandValidator : AbstractValidator<Command>
+    {
+        public CommandValidator()
+        {
+            RuleFor(x => x.User).NotNull();
+            RuleFor(x => x.User.Password)
+                .NotEmpty()
+                .When(x => x.User != null)
+                .WithMessage(Constants.BLANK);
+        }
+    }
+
+    public class Handler(
+        ConduitContext context,
+        ICurrentUserAccessor currentUserAccessor,
+        IPasswordHasher passwordHasher
+    ) : IRequestHandler<Command>
+    {
+        public async ValueTask<Unit> Handle(Command message, CancellationToken cancellationToken)
+        {
+            var personId = currentUserAccessor.GetCurrentPersonId();
+            var person = await context.Persons.FirstOrDefaultAsync(
+                x => x.PersonId == personId,
+                cancellationToken
+            );
+            if (person is null)
+            {
+                throw new RestException(HttpStatusCode.Unauthorized, "token", "is invalid");
+            }
+
+            var verification = passwordHasher.Verify(
+                message.User.Password!,
+                person.Hash,
+                person.Salt
+            );
+            if (verification == PasswordVerificationResult.Failed)
+            {
+                throw new RestException(
+                    HttpStatusCode.UnprocessableEntity,
+                    "password",
+                    "is invalid"
+                );
+            }
+
+            var ownArticleIds = context
+                .Articles.Where(x => x.Author != null && x.Author.PersonId == person.PersonId)
+                .Select(x => x.ArticleId);
+
+            await context
+                .Comments.Where(x =>
+                    ownArticleIds.Contains(x.ArticleId) || x.AuthorId == person.PersonId
+                )
+                .ExecuteDeleteAsync(cancellationToken);
+            await context
+                .ArticleFavorites.Where(x =>
+                    ownArticleIds.Contains(x.ArticleId) || x.PersonId == person.PersonId
+                )
+                .ExecuteDeleteAsync(cancellationToken);
+            await context
+                .ArticleTags.Where(x => ownArticleIds.Contains(x.ArticleId))
+                .ExecuteDeleteAsync(cancellationToken);
+            await context
+                .Articles.Where(x => x.Author != null && x.Author.PersonId == person.PersonId)
+                .ExecuteDeleteAsync(cancellationToken);
+            await context
+                .FollowedPeople.Where(x =>
+                    x.ObserverId == person.PersonId || x.TargetId == person.PersonId
+                )
+                .ExecuteDeleteAsync(cancellationToken);
+            await context
+                .Persons.Where(x => x.PersonId == person.PersonId)
+                .ExecuteDeleteAsync(cancellationToken);
+
+            return Unit.Value;
+        }
+    }
+}
