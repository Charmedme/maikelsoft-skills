@@ -0,0 +1,152 @@
+using ClassifiedAds.Application.AuditLogEntries.Queries;
+using ClassifiedAds.Application.AuditLogEntries.Services;
+using Microsoft.AspNetCore.Mvc;
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+
+namespace ClassifiedAds.WebAPI.Models.AuditLogEntries;
+
+/// <summary>
+/// The query string of GET api/auditlogentries/search. All values are text, so that a wrong value
+/// gives a validation error on its field and not a binding error.
+/// </summary>
+public class AuditLogSearchModel
+{
+    public const int DefaultPageSize = 20;
+
+    public const int MaxPageSize = 100;
+
+    public const int MaxDays = 366;
+
+    [FromQuery(Name = "from")]
+    public string From { get; set; }
+
+    [FromQuery(Name = "to")]
+    public string To { get; set; }
+
+    [FromQuery(Name = "timeZone")]
+    public string TimeZone { get; set; }
+
+    [FromQuery(Name = "userName")]
+    public string UserName { get; set; }
+
+    [FromQuery(Name = "action")]
+    public string Action { get; set; }
+
+    [FromQuery(Name = "page")]
+    public string Page { get; set; }
+
+    [FromQuery(Name = "pageSize")]
+    public string PageSize { get; set; }
+
+    /// <summary>
+    /// Validates the values and makes the query. The days are whole days in the time zone (UTC when
+    /// no time zone is given), and both days are included.
+    /// </summary>
+    public bool TryCreateQuery(out SearchAuditEntriesQuery query, out Dictionary<string, string[]> errors)
+    {
+        query = null;
+        var problems = new Dictionary<string, List<string>>();
+
+        void Add(string field, string message)
+        {
+            if (!problems.TryGetValue(field, out var list))
+            {
+                problems[field] = list = new List<string>();
+            }
+
+            list.Add(message);
+        }
+
+        DateOnly? from = null;
+        if (!string.IsNullOrEmpty(From))
+        {
+            if (DateOnly.TryParseExact(From, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var value))
+            {
+                from = value;
+            }
+            else
+            {
+                Add("from", "The from date must be a date in the format yyyy-MM-dd.");
+            }
+        }
+
+        DateOnly? to = null;
+        if (!string.IsNullOrEmpty(To))
+        {
+            if (DateOnly.TryParseExact(To, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var value))
+            {
+                to = value;
+            }
+            else
+            {
+                Add("to", "The to date must be a date in the format yyyy-MM-dd.");
+            }
+        }
+
+        if (from.HasValue && to.HasValue)
+        {
+            if (from.Value > to.Value)
+            {
+                Add("from", "The from date must be on or before the to date.");
+                Add("to", "The to date must be on or after the from date.");
+            }
+            else if (to.Value.DayNumber - from.Value.DayNumber + 1 > MaxDays)
+            {
+                Add("to", $"The range can have at most {MaxDays} days.");
+            }
+        }
+
+        var timeZone = TimeZoneInfo.Utc;
+        if (!string.IsNullOrEmpty(TimeZone))
+        {
+            try
+            {
+                timeZone = TimeZoneInfo.FindSystemTimeZoneById(TimeZone);
+            }
+            catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException)
+            {
+                Add("timeZone", "The time zone is not known. Use an IANA name such as Europe/Amsterdam.");
+            }
+        }
+
+        var page = 1;
+        if (!string.IsNullOrEmpty(Page)
+            && (!int.TryParse(Page, NumberStyles.Integer, CultureInfo.InvariantCulture, out page) || page < 1))
+        {
+            Add("page", "The page must be a whole number of 1 or more.");
+        }
+
+        var pageSize = DefaultPageSize;
+        if (!string.IsNullOrEmpty(PageSize)
+            && (!int.TryParse(PageSize, NumberStyles.Integer, CultureInfo.InvariantCulture, out pageSize) || pageSize < 1 || pageSize > MaxPageSize))
+        {
+            Add("pageSize", $"The page size must be a whole number from 1 to {MaxPageSize}.");
+        }
+
+        if (problems.Count > 0)
+        {
+            errors = new Dictionary<string, string[]>();
+            foreach (var problem in problems)
+            {
+                errors[problem.Key] = problem.Value.ToArray();
+            }
+
+            return false;
+        }
+
+        var (fromUtc, toUtcExclusive) = DayRange.ToUtcRange(from, to, timeZone);
+        query = new SearchAuditEntriesQuery
+        {
+            FromUtc = fromUtc,
+            ToUtcExclusive = toUtcExclusive,
+            UserName = string.IsNullOrEmpty(UserName) ? null : UserName,
+            Action = string.IsNullOrEmpty(Action) ? null : Action,
+            Page = page,
+            PageSize = pageSize,
+        };
+        errors = null;
+        return true;
+    }
+}
