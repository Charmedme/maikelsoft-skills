@@ -0,0 +1,45 @@
+using ClassifiedAds.Application.AuditLogEntries.Services;
+using System;
+using Xunit;
+
+namespace ClassifiedAds.UnitTests.Application.AuditLogEntries;
+
+public class DayRangeTests
+{
+    [Theory]
+    [InlineData("UTC", "2024-06-15", "2024-06-15T00:00:00Z")]
+    [InlineData("Pacific/Kiritimati", "2024-06-15", "2024-06-14T10:00:00Z")]
+    [InlineData("Etc/GMT+12", "2024-06-15", "2024-06-15T12:00:00Z")]
+    [InlineData("Europe/Amsterdam", "2024-01-15", "2024-01-14T23:00:00Z")]
+    [InlineData("Europe/Amsterdam", "2024-07-15", "2024-07-14T22:00:00Z")]
+    [InlineData("America/Santiago", "2024-09-08", "2024-09-08T04:00:00Z")]
+    public void StartOfDayUtc_ReturnsFirstInstantOfLocalDay(string timeZoneId, string day, string expected)
+    {
+        var timeZone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
+
+        var start = DayRange.StartOfDayUtc(DateOnly.Parse(day, System.Globalization.CultureInfo.InvariantCulture), timeZone);
+
+        Assert.Equal(DateTimeKind.Utc, start.Kind);
+        Assert.Equal(DateTime.Parse(expected, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AdjustToUniversal), start);
+    }
+
+    [Fact]
+    public void ToUtcRange_IncludesBothDays()
+    {
+        var timeZone = TimeZoneInfo.FindSystemTimeZoneById("Pacific/Kiritimati");
+
+        var (start, end) = DayRange.ToUtcRange(new DateOnly(2024, 6, 15), new DateOnly(2024, 6, 15), timeZone);
+
+        Assert.Equal(new DateTimeOffset(2024, 6, 14, 10, 0, 0, TimeSpan.Zero), start);
+        Assert.Equal(new DateTimeOffset(2024, 6, 15, 10, 0, 0, TimeSpan.Zero), end);
+    }
+
+    [Fact]
+    public void ToUtcRange_WithoutDays_HasOpenEnds()
+    {
+        var (start, end) = DayRange.ToUtcRange(null, null, TimeZoneInfo.Utc);
+
+        Assert.Null(start);
+        Assert.Null(end);
+    }
+}
