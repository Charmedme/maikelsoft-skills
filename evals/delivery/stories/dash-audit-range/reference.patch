+using System;
+
+namespace ClassifiedAds.Application.AuditLogEntries.Services;
+
+/// <summary>
+/// Converts whole days in a time zone to instants in UTC.
+/// </summary>
+public static class DayRange
+{
+    /// <summary>
+    /// Returns the first instant (UTC) of the day in the time zone. When the local midnight does not
+    /// exist (a clock change at midnight), the day starts at the end of the gap. When the local midnight
+    /// occurs two times, the day starts at the first one.
+    /// </summary>
+    public static DateTime StartOfDayUtc(DateOnly day, TimeZoneInfo timeZone)
+    {
+        ArgumentNullException.ThrowIfNull(timeZone);
+
+        var local = day.ToDateTime(TimeOnly.MinValue, DateTimeKind.Unspecified);
+
+        while (timeZone.IsInvalidTime(local))
+        {
+            local = local.AddMinutes(1);
+        }
+
+        if (timeZone.IsAmbiguousTime(local))
+        {
+            var offsets = timeZone.GetAmbiguousTimeOffsets(local);
+            var largest = offsets[0] > offsets[1] ? offsets[0] : offsets[1];
+            return DateTime.SpecifyKind(local - largest, DateTimeKind.Utc);
+        }
+
+        return TimeZoneInfo.ConvertTimeToUtc(local, timeZone);
+    }
+
+    /// <summary>
+    /// Returns the UTC range [start, end) that covers the days from <paramref name="from"/> to
+    /// <paramref name="to"/> in the time zone. Both days are included. A null day gives an open end.
+    /// </summary>
+    public static (DateTimeOffset? StartUtc, DateTimeOffset? EndUtc) ToUtcRange(DateOnly? from, DateOnly? to, TimeZoneInfo timeZone)
+    {
+        DateTimeOffset? start = from.HasValue ? new DateTimeOffset(StartOfDayUtc(from.Value, timeZone), TimeSpan.Zero) : null;
+        DateTimeOffset? end = to.HasValue ? new DateTimeOffset(StartOfDayUtc(to.Value.AddDays(1), timeZone), TimeSpan.Zero) : null;
+        return (start, end);
+    }
+}
