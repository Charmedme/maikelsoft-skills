@@ -0,0 +1,107 @@
+using ClassifiedAds.Application.AuditLogEntries.DTOs;
+using ClassifiedAds.Application.Common.DTOs;
+using ClassifiedAds.Domain.Entities;
+using ClassifiedAds.Domain.Repositories;
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace ClassifiedAds.Application.AuditLogEntries.Queries;
+
+/// <summary>
+/// Audit log entries in a UTC range, for one user name and one action, newest first, one page.
+/// </summary>
+public class SearchAuditEntriesQuery : IQuery<Paged<AuditLogEntryDTO>>
+{
+    /// <summary>Gets or sets the first instant that is included. Null: no lower limit.</summary>
+    public DateTimeOffset? FromUtc { get; set; }
+
+    /// <summary>Gets or sets the first instant that is not included. Null: no upper limit.</summary>
+    public DateTimeOffset? ToUtcExclusive { get; set; }
+
+    /// <summary>Gets or sets the user name. Exact match without regard to case. Null: all users.</summary>
+    public string UserName { get; set; }
+
+    /// <summary>Gets or sets the action. Exact match without regard to case. Null: all actions.</summary>
+    public string Action { get; set; }
+
+    /// <summary>Gets or sets the page number. The first page is 1.</summary>
+    public int Page { get; set; } = 1;
+
+    public int PageSize { get; set; } = 20;
+}
+
+internal class SearchAuditEntriesQueryHandler : IQueryHandler<SearchAuditEntriesQuery, Paged<AuditLogEntryDTO>>
+{
+    private readonly IAuditLogEntryReadOnlyRepository _auditLogEntryRepository;
+    private readonly IReadOnlyRepository<User, Guid> _userRepository;
+
+    public SearchAuditEntriesQueryHandler(IAuditLogEntryReadOnlyRepository auditLogEntryRepository, IReadOnlyRepository<User, Guid> userRepository)
+    {
+        _auditLogEntryRepository = auditLogEntryRepository;
+        _userRepository = userRepository;
+    }
+
+    public async Task<Paged<AuditLogEntryDTO>> HandleAsync(SearchAuditEntriesQuery query, CancellationToken cancellationToken = default)
+    {
+        var auditLogs = _auditLogEntryRepository.Get(new AuditLogEntryQueryOptions { AsNoTracking = true });
+        var users = _userRepository.GetQueryableSet();
+
+        var rs = auditLogs.Join(users, x => x.UserId, y => y.Id,
+            (x, y) => new AuditLogEntryDTO
+            {
+                Id = x.Id,
+                UserId = x.UserId,
+                Action = x.Action,
+                ObjectId = x.ObjectId,
+                Log = x.Log,
+                CreatedDateTime = x.CreatedDateTime,
+                UserName = y.UserName,
+            });
+
+        if (query.FromUtc.HasValue)
+        {
+            var fromUtc = query.FromUtc.Value.ToUniversalTime();
+            rs = rs.Where(x => x.CreatedDateTime >= fromUtc);
+        }
+
+        if (query.ToUtcExclusive.HasValue)
+        {
+            var toUtc = query.ToUtcExclusive.Value.ToUniversalTime();
+            rs = rs.Where(x => x.CreatedDateTime < toUtc);
+        }
+
+        if (!string.IsNullOrEmpty(query.UserName))
+        {
+            var userName = query.UserName.ToUpperInvariant();
+            rs = rs.Where(x => x.UserName.ToUpper() == userName);
+        }
+
+        if (!string.IsNullOrEmpty(query.Action))
+        {
+            var action = query.Action.ToUpperInvariant();
+            rs = rs.Where(x => x.Action.ToUpper() == action);
+        }
+
+        var result = new Paged<AuditLogEntryDTO>
+        {
+            TotalItems = rs.LongCount(),
+        };
+
+        var skip = ((long)query.Page - 1) * query.PageSize;
+        if (skip >= result.TotalItems)
+        {
+            result.Items = [];
+            return result;
+        }
+
+        result.Items = await _userRepository.ToListAsync(rs
+            .OrderByDescending(x => x.CreatedDateTime)
+            .ThenBy(x => x.Id)
+            .Skip((int)skip)
+            .Take(query.PageSize));
+
+        return result;
+    }
+}
