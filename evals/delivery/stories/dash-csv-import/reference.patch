@@ -0,0 +1,185 @@
+using ClassifiedAds.Application.Products.DTOs;
+using ClassifiedAds.Domain.Entities;
+using ClassifiedAds.Domain.Repositories;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace ClassifiedAds.Application.Products.Commands;
+
+/// <summary>
+/// Imports the products of a CSV file, all or nothing. A line whose code (trimmed, without regard to
+/// case) matches an existing product updates that product. Other lines create a product.
+/// After the command, <see cref="Errors"/> has the errors (nothing was stored), or the counts are set.
+/// </summary>
+public class ImportProductsCommand : ICommand
+{
+    public ImportProductsFromCsv File { get; set; }
+
+    public List<ImportProductsError> Errors { get; set; } = [];
+
+    public int Created { get; set; }
+
+    public int Updated { get; set; }
+
+    public int Unchanged { get; set; }
+}
+
+/// <summary>
+/// The rules for a product CSV file.
+/// </summary>
+public static class ImportProductsRules
+{
+    public const int MaxProducts = 1000;
+
+    public const int MaxNameLength = 100;
+
+    public static readonly string[] Header = ["Code", "Name", "Description"];
+
+    public static string NormalizeCode(string code) => code.Trim().ToUpperInvariant();
+
+    /// <summary>
+    /// Returns the product lines of the file, or the errors. The errors are sorted by line.
+    /// </summary>
+    public static List<ImportProductsError> Validate(ImportProductsFromCsv file, out List<ImportProductsFromCsvRecord> productLines)
+    {
+        productLines = [];
+
+        if (file.Errors.Count > 0)
+        {
+            return file.Errors.ToList();
+        }
+
+        var header = file.Records.FirstOrDefault();
+        if (header == null
+            || header.Line != 1
+            || header.Fields.Count != Header.Length
+            || !header.Fields.Select(x => x.Trim()).SequenceEqual(Header, StringComparer.OrdinalIgnoreCase))
+        {
+            return [new ImportProductsError(1, "The first line must be the header Code,Name,Description.")];
+        }
+
+        var lines = file.Records.Skip(1).Where(x => !x.IsBlank).ToList();
+
+        if (lines.Count > MaxProducts)
+        {
+            return [new ImportProductsError(lines[MaxProducts].Line, $"The file has more than {MaxProducts} products. Import at most {MaxProducts} products at a time.")];
+        }
+
+        var errors = new List<ImportProductsError>();
+
+        foreach (var line in lines)
+        {
+            var code = line.Fields[0];
+            var name = line.Fields.Count > 1 ? line.Fields[1] : string.Empty;
+
+            if (line.Fields.Count > Header.Length)
+            {
+                errors.Add(new ImportProductsError(line.Line, $"The line has {line.Fields.Count} fields. A line has at most 3 fields: Code,Name,Description."));
+            }
+
+            if (string.IsNullOrWhiteSpace(code))
+            {
+                errors.Add(new ImportProductsError(line.Line, "The code is empty."));
+            }
+
+            if (string.IsNullOrWhiteSpace(name))
+            {
+                errors.Add(new ImportProductsError(line.Line, "The name is empty."));
+            }
+            else if (name.Length > MaxNameLength)
+            {
+                errors.Add(new ImportProductsError(line.Line, $"The name has {name.Length} characters. The maximum is {MaxNameLength}."));
+            }
+        }
+
+        var duplicates = lines
+            .Where(x => !string.IsNullOrWhiteSpace(x.Fields[0]))
+            .GroupBy(x => NormalizeCode(x.Fields[0]))
+            .Where(x => x.Count() > 1);
+
+        foreach (var group in duplicates)
+        {
+            foreach (var line in group)
+            {
+                var others = string.Join(", ", group.Where(x => x != line).Select(x => x.Line));
+                errors.Add(new ImportProductsError(line.Line, $"The code {line.Fields[0].Trim()} is also on line {others}."));
+            }
+        }
+
+        if (errors.Count == 0)
+        {
+            productLines = lines;
+        }
+
+        return errors.OrderBy(x => x.Line).ToList();
+    }
+}
+
+internal class ImportProductsCommandHandler : ICommandHandler<ImportProductsCommand>
+{
+    private readonly ICrudService<Product> _productService;
+    private readonly IRepository<Product, Guid> _productRepository;
+    private readonly IUnitOfWork _unitOfWork;
+
+    public ImportProductsCommandHandler(ICrudService<Product> productService, IRepository<Product, Guid> productRepository, IUnitOfWork unitOfWork)
+    {
+        _productService = productService;
+        _productRepository = productRepository;
+        _unitOfWork = unitOfWork;
+    }
+
+    public async Task HandleAsync(ImportProductsCommand command, CancellationToken cancellationToken = default)
+    {
+        command.Errors = ImportProductsRules.Validate(command.File, out var lines);
+        if (command.Errors.Count > 0)
+        {
+            return;
+        }
+
+        var codes = lines.Select(x => ImportProductsRules.NormalizeCode(x.Fields[0])).ToList();
+        var existingProducts = await _productRepository.ToListAsync(_productRepository.GetQueryableSet()
+            .Where(x => codes.Contains(x.Code.Trim().ToUpper())));
+
+        // When older data has more than one product with the same code, the oldest one is updated.
+        var productsByCode = existingProducts
+            .OrderBy(x => x.CreatedDateTime)
+            .GroupBy(x => ImportProductsRules.NormalizeCode(x.Code))
+            .ToDictionary(x => x.Key, x => x.First());
+
+        // One transaction: each create and update writes its audit log entry and outbox message
+        // through the normal event handlers, and nothing is stored when one save fails.
+        using (await _unitOfWork.BeginTransactionAsync(System.Data.IsolationLevel.ReadCommitted, cancellationToken))
+        {
+            foreach (var line in lines)
+            {
+                var code = line.Fields[0].Trim();
+                var name = line.Fields[1];
+                var description = line.Fields.Count > 2 ? line.Fields[2] : string.Empty;
+
+                if (!productsByCode.TryGetValue(ImportProductsRules.NormalizeCode(code), out var product))
+                {
+                    await _productService.AddAsync(new Product { Code = code, Name = name, Description = description }, cancellationToken);
+                    command.Created++;
+                    continue;
+                }
+
+                if (product.Code == code && product.Name == name && (product.Description ?? string.Empty) == description)
+                {
+                    command.Unchanged++;
+                    continue;
+                }
+
+                product.Code = code;
+                product.Name = name;
+                product.Description = description;
+                await _productService.UpdateAsync(product, cancellationToken);
+                command.Updated++;
+            }
+
+            await _unitOfWork.CommitTransactionAsync(cancellationToken);
+        }
+    }
+}
