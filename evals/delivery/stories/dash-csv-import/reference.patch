@@ -0,0 +1,52 @@
+using ClassifiedAds.Application.Products.Commands;
+using ClassifiedAds.Infrastructure.Csv;
+using System.Linq;
+using Xunit;
+
+namespace ClassifiedAds.UnitTests.Application.Products;
+
+public class ImportProductsRulesTests
+{
+    [Fact]
+    public void Validate_ValidFile_ReturnsProductLinesWithoutBlankLines()
+    {
+        var file = ImportProductsFromCsvHandler.Parse("Code,Name,Description\nA,a,\n\nB,b,desc\n");
+
+        var errors = ImportProductsRules.Validate(file, out var lines);
+
+        Assert.Empty(errors);
+        Assert.Equal([2, 4], lines.Select(x => x.Line));
+    }
+
+    [Fact]
+    public void Validate_WrongLines_ReportsEachLineAndBothDuplicates()
+    {
+        var file = ImportProductsFromCsvHandler.Parse("Code,Name,Description\n,a,\nB,,\nC," + new string('n', 101) + ",\n ab ,x,\nAB,y,\nD," + new string('n', 100) + ",\n");
+
+        var errors = ImportProductsRules.Validate(file, out var lines);
+
+        Assert.Empty(lines);
+        Assert.Equal([2, 3, 4, 5, 6], errors.Select(x => x.Line));
+    }
+
+    [Theory]
+    [InlineData("")]
+    [InlineData("Name,Code,Description\n")]
+    [InlineData("Code,Name\n")]
+    public void Validate_WrongHeader_RefusesTheFile(string text)
+    {
+        var errors = ImportProductsRules.Validate(ImportProductsFromCsvHandler.Parse(text), out _);
+
+        Assert.Equal(1, Assert.Single(errors).Line);
+    }
+
+    [Fact]
+    public void Validate_MoreThan1000Products_RefusesTheFile()
+    {
+        var text = "Code,Name,Description\n" + string.Concat(Enumerable.Range(0, 1001).Select(i => $"C{i},N,\n"));
+
+        var errors = ImportProductsRules.Validate(ImportProductsFromCsvHandler.Parse(text), out _);
+
+        Assert.Single(errors);
+    }
+}
