@@ -0,0 +1,40 @@
+using ClassifiedAds.Infrastructure.Csv;
+using System.Linq;
+using Xunit;
+
+namespace ClassifiedAds.UnitTests.Infrastructure.Csv;
+
+public class ImportProductsFromCsvHandlerTests
+{
+    [Fact]
+    public void Parse_QuotedFields_KeepCommasQuotesAndLineBreaks()
+    {
+        var file = ImportProductsFromCsvHandler.Parse("﻿Code,Name,Description\r\nA,\"x, y\",\"say \"\"hi\"\"\nnext\"\r\nB,b,\n");
+
+        Assert.Empty(file.Errors);
+        Assert.Equal(3, file.Records.Count);
+        Assert.Equal(["Code", "Name", "Description"], file.Records[0].Fields);
+        Assert.Equal(["A", "x, y", "say \"hi\"\nnext"], file.Records[1].Fields);
+        Assert.Equal(2, file.Records[1].Line);
+        Assert.Equal(4, file.Records[2].Line);
+        Assert.Equal(["B", "b", string.Empty], file.Records[2].Fields);
+    }
+
+    [Fact]
+    public void Parse_EmptyLines_AreBlankAndKeepTheLineNumbers()
+    {
+        var file = ImportProductsFromCsvHandler.Parse("Code,Name,Description\n\n  \nA,a,\n");
+
+        Assert.Equal([false, true, true, false], file.Records.Select(x => x.IsBlank));
+        Assert.Equal(4, file.Records[3].Line);
+    }
+
+    [Fact]
+    public void Parse_QuoteWithoutEnd_GivesErrorOnStartLine()
+    {
+        var file = ImportProductsFromCsvHandler.Parse("Code,Name,Description\nA,\"open\nB,b,\n");
+
+        var error = Assert.Single(file.Errors);
+        Assert.Equal(2, error.Line);
+    }
+}
