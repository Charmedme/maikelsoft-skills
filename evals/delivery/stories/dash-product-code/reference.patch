+    /// <summary>
+    /// Two codes are the same when they are equal without regard to case. The code must be trimmed.
+    /// </summary>
+    private static Task<bool> IsCodeUsedByOtherProductAsync(IRepository<Product, Guid> productRepository, string code, Guid productId)
+    {
+        var normalizedCode = code.ToUpperInvariant();
+        return productRepository.GetQueryableSet()
+            .AnyAsync(x => x.Id != productId && x.Code.ToUpper() == normalizedCode);
+    }
+
+    /// <summary>
+    /// Saves the product. Returns false when the unique index on the code refused the save, because
+    /// another request stored the same code after the check.
+    /// </summary>
+    private static async Task<bool> TrySaveAsync(Dispatcher dispatcher, IRepository<Product, Guid> productRepository, Product product)
+    {
+        try
+        {
+            await dispatcher.DispatchAsync(new AddUpdateProductCommand { Product = product });
+            return true;
+        }
+        catch (DbUpdateException)
+        {
+            if (await IsCodeUsedByOtherProductAsync(productRepository, product.Code, product.Id))
+            {
+                return false;
+            }
+
+            throw;
+        }
+    }
+
+    private static IResult CodeAlreadyUsed()
+    {
+        return Results.ValidationProblem(new Dictionary<string, string[]>
+        {
+            [nameof(ProductModel.Code)] = ["The Code is already used by another product."],
+        });
+    }
