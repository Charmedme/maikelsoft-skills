+++ b/src/Conduit/Features/Articles/Slugs.cs
@@ -0,0 +1,53 @@
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Conduit.Domain;
+using Conduit.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+namespace Conduit.Features.Articles;
+
+public static class Slugs
+{
+    // a slug is taken when another article has it now or had it before
+    public static async Task<string> UniqueSlug(
+        this ConduitContext context,
+        string slug,
+        int? articleId,
+        CancellationToken cancellationToken
+    )
+    {
+        var candidate = slug;
+        for (var i = 1; await context.IsTaken(candidate, articleId, cancellationToken); i++)
+        {
+            candidate = $"{slug}-{i}";
+        }
+        return candidate;
+    }
+
+    private static async Task<bool> IsTaken(
+        this ConduitContext context,
+        string slug,
+        int? articleId,
+        CancellationToken cancellationToken
+    ) =>
+        await context.Articles.AnyAsync(
+            x => x.Slug == slug && x.ArticleId != articleId,
+            cancellationToken
+        )
+        || await context.ArticleSlugs.AnyAsync(
+            x => x.Slug == slug && x.ArticleId != articleId,
+            cancellationToken
+        );
+
+    // the current slug, or an earlier slug of the same article (for reading only)
+    public static IQueryable<Article> BySlugOrEarlierSlug(
+        this IQueryable<Article> articles,
+        ConduitContext context,
+        string slug
+    ) =>
+        articles.Where(x =>
+            x.Slug == slug
+            || context.ArticleSlugs.Any(y => y.Slug == slug && y.ArticleId == x.ArticleId)
+        );
+}
