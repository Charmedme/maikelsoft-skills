diff --git a/src/Conduit/Features/Articles/Revisions.cs b/src/Conduit/Features/Articles/Revisions.cs
new file mode 100644
index 0000000..c4fc3ff
--- /dev/null
+++ b/src/Conduit/Features/Articles/Revisions.cs
@@ -0,0 +1,80 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using Conduit.Infrastructure;
+using Conduit.Infrastructure.Errors;
+using Mediator;
+using Microsoft.EntityFrameworkCore;
+
+namespace Conduit.Features.Articles;
+
+public class Revisions
+{
+    public record Query(string Slug) : IRequest<RevisionsEnvelope>, IReadOnlyRequest;
+
+    public class RevisionView
+    {
+        public int Version { get; init; }
+        public string? Title { get; init; }
+        public string? Description { get; init; }
+        public string? Body { get; init; }
+        public List<string> TagList { get; init; } = [];
+        public DateTime UpdatedAt { get; init; }
+    }
+
+    public class RevisionsEnvelope
+    {
+        public List<RevisionView> Revisions { get; init; } = [];
+        public int RevisionsCount { get; init; }
+    }
+
+    public class QueryHandler(ConduitContext context, ICurrentUserAccessor currentUserAccessor)
+        : IRequestHandler<Query, RevisionsEnvelope>
+    {
+        public async ValueTask<RevisionsEnvelope> Handle(
+            Query message,
+            CancellationToken cancellationToken
+        )
+        {
+            var article =
+                await context
+                    .Articles.AsNoTracking()
+                    .Include(x => x.Author)
+                    .BySlugOrEarlierSlug(context, message.Slug)
+                    .FirstOrDefaultAsync(cancellationToken)
+                ?? throw new RestException(HttpStatusCode.NotFound, "article", Constants.NOT_FOUND);
+
+            if (article.Author?.PersonId != currentUserAccessor.GetCurrentPersonId())
+            {
+                throw new RestException(HttpStatusCode.Forbidden, "article", Constants.FORBIDDEN);
+            }
+
+            var revisions = await context
+                .ArticleRevisions.AsNoTracking()
+                .Where(x => x.ArticleId == article.ArticleId)
+                .OrderByDescending(x => x.Version)
+                .ToListAsync(cancellationToken);
+
+            return new RevisionsEnvelope
+            {
+                Revisions =
+                [
+                    .. revisions.Select(x => new RevisionView
+                    {
+                        Version = x.Version,
+                        Title = x.Title,
+                        Description = x.Description,
+                        Body = x.Body,
+                        TagList = JsonSerializer.Deserialize<List<string>>(x.TagList) ?? [],
+                        UpdatedAt = x.UpdatedAt,
+                    }),
+                ],
+                RevisionsCount = revisions.Count,
+            };
+        }
+    }
+}
diff --git a/src/Conduit/Features/Articles/Slugs.cs b/src/Conduit/Features/Articles/Slugs.cs
