     private static async Task<IResult> Put(Guid id, [FromBody] ProductModel model,
         [FromServices] Dispatcher dispatcher)
     {
+        if (!TryParseRowVersion(model.RowVersion, out var rowVersion))
+        {
+            return Results.ValidationProblem(new Dictionary<string, string[]>
+            {
+                [nameof(ProductModel.RowVersion)] = ["The RowVersion is required. Send the RowVersion of the product that you edited."],
+            });
+        }
+
         var product = await dispatcher.DispatchAsync(new GetProductQuery { Id = id, ThrowNotFoundIfNull = true });
 
+        // Optimistic concurrency: the editor must start from the current version. The concurrency
+        // token of the entity also refuses an update when another update was saved after this load.
+        if (product.RowVersion == null || !product.RowVersion.AsSpan().SequenceEqual(rowVersion))
+        {
+            return ProductChanged();
+        }
+
         product.Code = model.Code;
         product.Name = model.Name;
         product.Description = model.Description;
 
-        await dispatcher.DispatchAsync(new AddUpdateProductCommand { Product = product });
+        try
+        {
+            await dispatcher.DispatchAsync(new AddUpdateProductCommand { Product = product });
+        }
+        catch (DbUpdateConcurrencyException)
+        {
+            return ProductChanged();
+        }
 
         model = product.ToModel();
 
         return Results.Ok(model);
     }
 
+    private static bool TryParseRowVersion(string value, out byte[] rowVersion)
+    {
+        rowVersion = null;
+        if (string.IsNullOrWhiteSpace(value))
+        {
+            return false;
+        }
+
+        try
+        {
+            rowVersion = Convert.FromBase64String(value);
+            return rowVersion.Length > 0;
+        }
+        catch (FormatException)
+        {
+            return false;
+        }
+    }
+
+    private static IResult ProductChanged()
+    {
+        return Results.Problem(
+            statusCode: StatusCodes.Status409Conflict,
+            title: "Conflict",
+            detail: "Somebody else changed the product after you opened it. Load the product again and repeat your change.");
+    }
