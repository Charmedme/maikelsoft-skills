@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# Smoke check against a running instance: PCA_API_PORT must be set. Exit 1 on the first failed check.
+set -uo pipefail
+: "${PCA_API_PORT:?set PCA_API_PORT}"
+B="http://127.0.0.1:$PCA_API_PORT"
+fail=0
+check() { # name expected actual
+  if [[ "$2" == "$3" ]]; then echo "PASS $1 -> $3"; else echo "FAIL $1 -> expected $2, got $3"; fail=1; fi
+}
+req() { # user method path [json] -> prints "status body"
+  local user="$1" method="$2" path="$3" data="${4:-}" hdr=()
+  [[ -n "$user" ]] && hdr=(-H "X-Test-User: $user")
+  if [[ -n "$data" ]]; then
+    curl -s -w '\n%{http_code}' -X "$method" "${hdr[@]}" -H 'Content-Type: application/json' -d "$data" "$B$path"
+  else
+    curl -s -w '\n%{http_code}' -X "$method" "${hdr[@]}" "$B$path"
+  fi
+}
+status() { tail -n1 <<<"$1"; }
+body() { sed '$d' <<<"$1"; }
+
+r=$(req admin GET /api/products);           check "admin GET /api/products" 200 "$(status "$r")"
+echo "     $(body "$r" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d), "products:", [p["code"] for p in d])')"
+r=$(req admin POST /api/products '{"code":"SMOKE1","name":"Smoke product","description":"created by smoke.sh"}')
+check "admin POST /api/products" 201 "$(status "$r")"
+id=$(body "$r" | python3 -c 'import sys,json; print(json.load(sys.stdin)["id"])'); echo "     id=$id"
+r=$(req admin GET "/api/products/$id");     check "admin GET /api/products/{id}" 200 "$(status "$r")"
+r=$(req admin PUT "/api/products/$id" '{"code":"SMOKE1","name":"Smoke product v2","description":"updated"}')
+check "admin PUT /api/products/{id}" 200 "$(status "$r")"; echo "     $(body "$r")"
+r=$(req admin GET "/api/products/$id/auditlogs"); check "admin GET /api/products/{id}/auditlogs" 200 "$(status "$r")"
+echo "     $(body "$r" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d), "entries:", [(e["userName"], e["action"]) for e in d])')"
+r=$(req admin DELETE "/api/products/$id");  check "admin DELETE /api/products/{id}" 200 "$(status "$r")"
+r=$(req admin GET "/api/products/$id");     check "admin GET deleted product" 404 "$(status "$r")"
+r=$(req admin GET /api/auditlogentries);    check "admin GET /api/auditlogentries" 200 "$(status "$r")"
+echo "     $(body "$r" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d), "entries, actions:", sorted({e["action"] for e in d}))')"
+r=$(req admin GET /api/users);              check "admin GET /api/users" 200 "$(status "$r")"
+echo "     $(body "$r" | python3 -c 'import sys,json; d=json.load(sys.stdin); print([u["userName"] for u in d])')"
+r=$(req user GET /api/products);            check "user GET /api/products" 200 "$(status "$r")"
+r=$(req user POST /api/products '{"code":"NOPE","name":"x","description":"x"}'); check "user POST /api/products" 403 "$(status "$r")"
+r=$(req user GET /api/users);               check "user GET /api/users" 403 "$(status "$r")"
+r=$(req "" GET /api/products);              check "anonymous GET /api/products" 401 "$(status "$r")"
+r=$(req nobody GET /api/products);          check "unknown user GET /api/products" 401 "$(status "$r")"
+exit $fail
diff --git a/eval/start.sh b/eval/start.sh
new file mode 100755
index 0000000..124f9d7
--- /dev/null
+++ b/eval/start.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+# Start one headless instance of the Monolith WebAPI with its own PostgreSQL container.
+#
+# Required env:  PCA_DB_PORT   host port for PostgreSQL (bound to 127.0.0.1)
+#                PCA_API_PORT  port for the WebAPI on http://127.0.0.1:$PCA_API_PORT
+# Optional env:  PCA_INSTANCE  instance name (default: $PCA_API_PORT); container = pca-db-$PCA_INSTANCE
+#                PCA_DATA_DIR  state dir: pid, logs, file storage (default: ${TMPDIR:-/tmp}/pca-$PCA_INSTANCE)
+#                PCA_DB_IMAGE  default postgres:17-alpine
+#                PCA_BUILD     1 = always run dotnet build (default: build only when the dll is missing)
+#                PCA_START_TIMEOUT  seconds to wait for /healthz (default 180)
+#                DOTNET        dotnet executable (default: dotnet on PATH, else ~/.dotnet/dotnet)
+#                PCA_UI_PORT   when set: also serve the Angular UI (headless config, test user) on
+#                              http://127.0.0.1:$PCA_UI_PORT; needs src/UIs/angular/node_modules
+set -euo pipefail
+
+: "${PCA_DB_PORT:?set PCA_DB_PORT}"
+: "${PCA_API_PORT:?set PCA_API_PORT}"
+PCA_INSTANCE="${PCA_INSTANCE:-$PCA_API_PORT}"
+PCA_DATA_DIR="${PCA_DATA_DIR:-${TMPDIR:-/tmp}/pca-$PCA_INSTANCE}"
+PCA_DB_IMAGE="${PCA_DB_IMAGE:-postgres:17-alpine}"
+PCA_START_TIMEOUT="${PCA_START_TIMEOUT:-180}"
+DB_CONTAINER="pca-db-$PCA_INSTANCE"
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+PROJECT_DIR="$ROOT/src/Monolith/ClassifiedAds.WebAPI"
+OUT_DIR="$PROJECT_DIR/bin/Debug/net10.0"
+DLL="$OUT_DIR/ClassifiedAds.WebAPI.dll"
+
+if [[ -z "${DOTNET:-}" ]]; then
+  if command -v dotnet >/dev/null 2>&1; then DOTNET=dotnet; else DOTNET="$HOME/.dotnet/dotnet"; fi
+fi
+
+mkdir -p "$PCA_DATA_DIR/files" "$PCA_DATA_DIR/temp"
+
+if [[ -f "$PCA_DATA_DIR/api.pid" ]] && kill -0 "$(cat "$PCA_DATA_DIR/api.pid")" 2>/dev/null; then
+  echo "instance $PCA_INSTANCE already runs (pid $(cat "$PCA_DATA_DIR/api.pid"))" >&2
+  exit 1
+fi
+
+# 1. Database container (data on tmpfs: each start gets an empty database).
+if docker container inspect "$DB_CONTAINER" >/dev/null 2>&1; then
+  echo "container $DB_CONTAINER exists already; run stop.sh first" >&2
+  exit 1
+fi
+docker run -d --rm --name "$DB_CONTAINER" \
+  --label pca.instance="$PCA_INSTANCE" \
+  -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=classifiedads \
+  -p "127.0.0.1:$PCA_DB_PORT:5432" \
+  --tmpfs /var/lib/postgresql:rw \
+  "$PCA_DB_IMAGE" -c fsync=off -c synchronous_commit=off -c full_page_writes=off >/dev/null
+
+# 2. Build (one build at a time when several instances start together).
+(
+  flock 9
+  if [[ "${PCA_BUILD:-0}" == "1" || ! -f "$DLL" ]]; then
+    "$DOTNET" build "$PROJECT_DIR/ClassifiedAds.WebAPI.csproj" -nologo -v q -clp:NoSummary >"$PCA_DATA_DIR/build.log" 2>&1 \
+      || { tail -n 30 "$PCA_DATA_DIR/build.log" >&2; exit 1; }
+  fi
+) 9>"$ROOT/eval/.build.lock"
+
+# 3. Wait for PostgreSQL over TCP (the init server only listens on the socket).
+for _ in $(seq 1 60); do
+  if docker exec "$DB_CONTAINER" pg_isready -h 127.0.0.1 -U postgres -d classifiedads >/dev/null 2>&1; then break; fi
+  sleep 1
+done
+docker exec "$DB_CONTAINER" pg_isready -h 127.0.0.1 -U postgres -d classifiedads >/dev/null
+
+# 4. WebAPI. Content root = output dir (appsettings*.json, Templates, Certs are copied there).
+cd "$OUT_DIR"
+TZ=UTC \
+ASPNETCORE_ENVIRONMENT=Testing \
+ASPNETCORE_URLS="http://127.0.0.1:$PCA_API_PORT" \
+DOTNET_NOLOGO=1 \
+ConnectionStrings__ClassifiedAds="Host=127.0.0.1;Port=$PCA_DB_PORT;Database=classifiedads;Username=postgres;Password=postgres" \
+Storage__Local__Path="$PCA_DATA_DIR/files" \
+Storage__TempFolderPath="$PCA_DATA_DIR/temp" \
+nohup "$DOTNET" "$DLL" >"$PCA_DATA_DIR/api.log" 2>&1 </dev/null &
+echo $! >"$PCA_DATA_DIR/api.pid"
+API_PID=$!
+
+# 5. Wait until healthy.
+deadline=$((SECONDS + PCA_START_TIMEOUT))
+until [[ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PCA_API_PORT/healthz" || true)" == "200" ]]; do
+  if ! kill -0 "$API_PID" 2>/dev/null; then
+    echo "WebAPI exited during start; last log lines:" >&2
+    tail -n 40 "$PCA_DATA_DIR/api.log" >&2
+    exit 1
+  fi
+  if (( SECONDS > deadline )); then
+    echo "WebAPI not healthy after ${PCA_START_TIMEOUT}s; see $PCA_DATA_DIR/api.log" >&2
+    exit 1
+  fi
+  sleep 1
+done
+
+# 6. Optional Angular UI: ng serve with the headless configuration, proxying /api and /hubs.
+if [[ -n "${PCA_UI_PORT:-}" ]]; then
+  UI_DIR="$ROOT/src/UIs/angular"
+  cd "$UI_DIR"
+  PCA_API_PORT="$PCA_API_PORT" NG_CLI_ANALYTICS=false \
+  setsid nohup node node_modules/@angular/cli/bin/ng.js serve --configuration headless \
+    --host 127.0.0.1 --port "$PCA_UI_PORT" --no-open --no-hmr --no-live-reload \
+    >"$PCA_DATA_DIR/ui.log" 2>&1 </dev/null &
+  UI_PID=$!
+  echo "$UI_PID" >"$PCA_DATA_DIR/ui.pid"
+  until [[ "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$PCA_UI_PORT/" || true)" == "200" ]]; do
+    if ! kill -0 "$UI_PID" 2>/dev/null; then
+      echo "ng serve exited during start; last log lines:" >&2; tail -n 40 "$PCA_DATA_DIR/ui.log" >&2; exit 1
+    fi
+    if (( SECONDS > deadline + 240 )); then
+      echo "UI not ready; see $PCA_DATA_DIR/ui.log" >&2; exit 1
+    fi
+    sleep 1
+  done
+  echo "PCA UI ready: http://127.0.0.1:$PCA_UI_PORT (test user admin; add ?test_user=user to switch)"
+fi
+
+echo "PCA instance $PCA_INSTANCE ready: api=http://127.0.0.1:$PCA_API_PORT pid=$API_PID db=$DB_CONTAINER(127.0.0.1:$PCA_DB_PORT) data=$PCA_DATA_DIR"
diff --git a/eval/stop.sh b/eval/stop.sh
new file mode 100755
index 0000000..25e4c61
--- /dev/null
+++ b/eval/stop.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# Stop one instance started by start.sh: the WebAPI by its PID file, the database by container name.
+# Env: PCA_API_PORT or PCA_INSTANCE, and PCA_DATA_DIR when start.sh got one.
+set -uo pipefail
+
+PCA_INSTANCE="${PCA_INSTANCE:-${PCA_API_PORT:?set PCA_INSTANCE or PCA_API_PORT}}"
+PCA_DATA_DIR="${PCA_DATA_DIR:-${TMPDIR:-/tmp}/pca-$PCA_INSTANCE}"
+DB_CONTAINER="pca-db-$PCA_INSTANCE"
+PID_FILE="$PCA_DATA_DIR/api.pid"
+
+UI_PID_FILE="$PCA_DATA_DIR/ui.pid"
+if [[ -f "$UI_PID_FILE" ]]; then
+  pid="$(cat "$UI_PID_FILE")"
+  # ng serve runs in its own session (setsid): stop its whole process group by PGID.
+  kill -TERM -- "-$pid" 2>/dev/null
+  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
+  kill -KILL -- "-$pid" 2>/dev/null
+  rm -f "$UI_PID_FILE"
+  echo "stopped UI process group $pid"
+fi
+
+if [[ -f "$PID_FILE" ]]; then
+  pid="$(cat "$PID_FILE")"
+  if kill -0 "$pid" 2>/dev/null; then
+    kill -TERM "$pid" 2>/dev/null
+    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
+    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
+  fi
+  rm -f "$PID_FILE"
+  echo "stopped WebAPI pid $pid"
+fi
+
+if docker container inspect "$DB_CONTAINER" >/dev/null 2>&1; then
+  docker rm -f "$DB_CONTAINER" >/dev/null && echo "removed container $DB_CONTAINER"
+fi
