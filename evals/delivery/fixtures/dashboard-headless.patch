+// Headless test mode (ng serve --configuration headless): no OIDC login.
+// The WebAPI runs with Authentication:Provider = "Test"; each API call sends X-Test-User.
+// The dev server proxies /api and /hubs to http://127.0.0.1:$PCA_API_PORT (proxy.headless.conf.js).
+// Switch user at runtime with ?test_user=user (kept in localStorage).
+export const environment = {
+  production: false,
+  OpenIdConnect: {
+    Authority: "http://127.0.0.1:1",
+    ClientId: "ClassifiedAds.Angular",
+  },
+  ResourceServer: {
+    Endpoint: "/api/",
+    NotificationEndpoint: "/hubs/notification",
+  },
+  CurrentUrl: "/",
+  TestUser: "admin",
+};
