@@ -0,0 +1,91 @@
+using ClassifiedAds.Persistence;
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.Logging;
+using Microsoft.Extensions.Options;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Security.Claims;
+using System.Text.Encodings.Web;
+using System.Threading.Tasks;
+
+namespace ClassifiedAds.WebAPI.Testing;
+
+/// <summary>
+/// Test-only scheme (Authentication:Provider = "Test"). The header X-Test-User holds the
+/// user name of a user in the database. The principal gets the roles of that user and the
+/// "Permission" claims of the user and of its roles. Never enable this scheme in production.
+/// </summary>
+public class TestAuthenticationHandler : AuthenticationHandler<AuthenticationSchemeOptions>
+{
+    public const string SchemeName = "Test";
+    public const string HeaderName = "X-Test-User";
+
+    private static readonly string IssuedAt = DateTimeOffset.UtcNow.ToUnixTimeSeconds().ToString(System.Globalization.CultureInfo.InvariantCulture);
+
+    private readonly AdsDbContext _dbContext;
+
+    public TestAuthenticationHandler(IOptionsMonitor<AuthenticationSchemeOptions> options,
+        ILoggerFactory logger,
+        UrlEncoder encoder,
+        AdsDbContext dbContext)
+        : base(options, logger, encoder)
+    {
+        _dbContext = dbContext;
+    }
+
+    protected override async Task<AuthenticateResult> HandleAuthenticateAsync()
+    {
+        string userName = Request.Headers[HeaderName].ToString();
+
+        // SignalR and file downloads cannot set headers: accept ?test_user=... as well.
+        if (string.IsNullOrWhiteSpace(userName))
+        {
+            userName = Request.Query["test_user"].ToString();
+        }
+
+        if (string.IsNullOrWhiteSpace(userName))
+        {
+            return AuthenticateResult.NoResult();
+        }
+
+        var normalized = userName.Trim().ToUpperInvariant();
+        var user = await _dbContext.Set<Domain.Entities.User>()
+            .AsNoTracking()
+            .Include(x => x.Claims)
+            .Include(x => x.UserRoles).ThenInclude(x => x.Role).ThenInclude(x => x.Claims)
+            .FirstOrDefaultAsync(x => x.NormalizedUserName == normalized, Context.RequestAborted);
+
+        if (user == null)
+        {
+            return AuthenticateResult.Fail($"Unknown test user '{userName}'.");
+        }
+
+        var claims = new List<Claim>
+        {
+            new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
+            new Claim("sub", user.Id.ToString()),
+            new Claim(ClaimTypes.Name, user.UserName),
+            new Claim("iat", IssuedAt),
+        };
+
+        if (!string.IsNullOrEmpty(user.Email))
+        {
+            claims.Add(new Claim(ClaimTypes.Email, user.Email));
+        }
+
+        var roles = user.UserRoles?.Select(x => x.Role).Where(x => x != null).ToList() ?? [];
+        claims.AddRange(roles.Select(r => new Claim(ClaimTypes.Role, r.Name)));
+
+        var permissionClaims = (user.Claims ?? [])
+            .Select(c => (c.Type, c.Value))
+            .Concat(roles.SelectMany(r => r.Claims ?? []).Select(c => (c.Type, c.Value)))
+            .Distinct()
+            .Select(c => new Claim(c.Type, c.Value));
+        claims.AddRange(permissionClaims);
+
+        var identity = new ClaimsIdentity(claims, SchemeName, ClaimTypes.Name, ClaimTypes.Role);
+        return AuthenticateResult.Success(new AuthenticationTicket(new ClaimsPrincipal(identity), SchemeName));
+    }
+}
diff --git a/src/Monolith/ClassifiedAds.WebAPI/Testing/TestDataSeeder.cs b/src/Monolith/ClassifiedAds.WebAPI/Testing/TestDataSeeder.cs
