diff --git a/src/Monolith/ClassifiedAds.Persistence/DbProviderExtensions.cs b/src/Monolith/ClassifiedAds.Persistence/DbProviderExtensions.cs
new file mode 100644
index 0000000..8365b5f
--- /dev/null
+++ b/src/Monolith/ClassifiedAds.Persistence/DbProviderExtensions.cs
@@ -0,0 +1,64 @@
+using ClassifiedAds.Domain.Entities;
+using Microsoft.Data.SqlTypes;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
+using System;
+using System.Linq;
+
+namespace ClassifiedAds.Persistence;
+
+/// <summary>
+/// Selects the EF Core provider from the connection string and adapts the model to it.
+/// A PostgreSQL connection string starts with "Host=". All other strings use SQL Server.
+/// </summary>
+public static class DbProviderExtensions
+{
+    public static bool IsPostgreSqlConnectionString(string connectionString)
+    {
+        return connectionString != null
+            && connectionString.TrimStart().StartsWith("Host=", StringComparison.OrdinalIgnoreCase);
+    }
+
+    public static DbContextOptionsBuilder UseConfiguredProvider(this DbContextOptionsBuilder optionsBuilder, string connectionString)
+    {
+        return IsPostgreSqlConnectionString(connectionString)
+            ? optionsBuilder.UseNpgsql(connectionString)
+            : optionsBuilder.UseSqlServer(connectionString);
+    }
+
+    public static void ApplyProviderConventions(this ModelBuilder modelBuilder, DatabaseFacade database)
+    {
+        if (!database.IsNpgsql())
+        {
+            return;
+        }
+
+        // SqlVector<float> (SQL Server vector type): store it as real[] so the tables and the
+        // plain queries still work. VectorDistance (vector search) has no translation here.
+        var vectorConverter = new ValueConverter<SqlVector<float>, float[]>(
+            v => v.Memory.ToArray(),
+            v => new SqlVector<float>(v));
+        modelBuilder.Entity<ProductEmbedding>().Property(x => x.Embedding).HasConversion(vectorConverter).HasColumnType("real[]");
+        modelBuilder.Entity<FileEntryEmbedding>().Property(x => x.Embedding).HasConversion(vectorConverter).HasColumnType("real[]");
+
+        foreach (var property in modelBuilder.Model.GetEntityTypes().SelectMany(x => x.GetProperties()))
+        {
+            if (string.Equals(property.GetDefaultValueSql(), "newsequentialid()", StringComparison.OrdinalIgnoreCase))
+            {
+                property.SetDefaultValueSql("gen_random_uuid()");
+            }
+
+            // [Timestamp] byte[] RowVersion: PostgreSQL has no rowversion type.
+            // Map it to the xmin system column, which PostgreSQL changes on each update.
+            if (property.Name == nameof(Entity<Guid>.RowVersion) && property.ClrType == typeof(byte[]) && property.IsConcurrencyToken)
+            {
+                property.SetColumnName("xmin");
+                property.SetColumnType("xid");
+                property.SetValueConverter(new ValueConverter<byte[], uint>(
+                    v => v == null ? 0u : BitConverter.ToUInt32(v, 0),
+                    v => BitConverter.GetBytes(v)));
+            }
+        }
+    }
+}
