@@ -0,0 +1,88 @@
+using ClassifiedAds.Domain.Entities;
+using ClassifiedAds.Persistence;
+using ClassifiedAds.WebAPI.Authorization;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+
+namespace ClassifiedAds.WebAPI.Testing;
+
+/// <summary>
+/// Creates the schema (EnsureCreated, no migrations) and seeds one fixed tenant with
+/// an "admin" user (all permissions) and a "user" user (read products only).
+/// Runs only when Database:EnsureCreatedAndSeed is true.
+/// </summary>
+public static class TestDataSeeder
+{
+    public static readonly string[] UserPermissions =
+    [
+        Permissions.GetProducts,
+        Permissions.GetProduct,
+    ];
+
+    public static void EnsureCreatedAndSeed(IServiceProvider services)
+    {
+        using var scope = services.CreateScope();
+        var db = scope.ServiceProvider.GetRequiredService<AdsDbContext>();
+        db.Database.EnsureCreated();
+
+        if (db.Set<User>().Any(x => x.NormalizedUserName == "ADMIN"))
+        {
+            return;
+        }
+
+        var now = DateTimeOffset.UtcNow;
+        var allPermissions = typeof(Permissions)
+            .GetFields(BindingFlags.Public | BindingFlags.Static)
+            .Select(f => (string)f.GetValue(null))
+            .ToList();
+
+        var adminRole = CreateRole("Admin", allPermissions, now);
+        var userRole = CreateRole("User", UserPermissions, now);
+
+        db.Set<Role>().AddRange(adminRole, userRole);
+        db.Set<User>().AddRange(
+            CreateUser("admin", "admin@example.test", adminRole, now),
+            CreateUser("user", "user@example.test", userRole, now));
+
+        db.Set<Product>().AddRange(
+            new Product { Code = "PD002", Name = "Galaxy S24", Description = "Samsung phone", CreatedDateTime = now },
+            new Product { Code = "PD003", Name = "Pixel 9", Description = "Google phone", CreatedDateTime = now },
+            new Product { Code = "PD004", Name = "ThinkPad X1", Description = "Lenovo laptop", CreatedDateTime = now });
+
+        db.SaveChanges();
+    }
+
+    private static Role CreateRole(string name, IEnumerable<string> permissions, DateTimeOffset now)
+    {
+        return new Role
+        {
+            Name = name,
+            NormalizedName = name.ToUpperInvariant(),
+            ConcurrencyStamp = Guid.NewGuid().ToString(),
+            CreatedDateTime = now,
+            Claims = permissions.Select(p => new RoleClaim { Type = "Permission", Value = p, CreatedDateTime = now }).ToList(),
+        };
+    }
+
+    private static User CreateUser(string userName, string email, Role role, DateTimeOffset now)
+    {
+        var user = new User
+        {
+            UserName = userName,
+            NormalizedUserName = userName.ToUpperInvariant(),
+            Email = email,
+            NormalizedEmail = email.ToUpperInvariant(),
+            EmailConfirmed = true,
+            SecurityStamp = Guid.NewGuid().ToString("N").ToUpperInvariant(),
+            ConcurrencyStamp = Guid.NewGuid().ToString(),
+            LockoutEnabled = true,
+            CreatedDateTime = now,
+        };
+        user.UserRoles = [new UserRole { User = user, Role = role, CreatedDateTime = now }];
+        return user;
+    }
+}
