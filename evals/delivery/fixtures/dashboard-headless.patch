diff --git a/src/Monolith/ClassifiedAds.WebAPI/Testing/TestAuthenticationHandler.cs b/src/Monolith/ClassifiedAds.WebAPI/Testing/TestAuthenticationHandler.cs
new file mode 100644
index 0000000..d5246c2
