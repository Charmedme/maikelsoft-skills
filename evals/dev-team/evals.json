{
  "plugin": "dev-team",
  "method": "Each story runs in a fresh copy of the orders-api fixture of dev-stack. Arm 'team' loads dev-team and dev-stack and starts the deliver-story skill. Arm 'baseline' loads dev-stack only and gets the same story and answer sheet. Both arms run headless with an answer sheet. The checks are in score.py; the judge assertions need a blind grader. Arm 'flow' loads dev-flow, dev-team, and dev-stack and starts the plan-and-build skill, which sets a tier and runs large items with dev-team.",
  "fixture": "orders-api",
  "prompt": {
    "team": "Use the dev-team:deliver-story skill to deliver the story in {story}. The answer sheet of the human is {answers}. Take each answer of the human from that sheet.",
    "baseline": "Deliver the story in {story}. The answer sheet of the human is {answers}. Take each answer of the human from that sheet. Work on a new branch and commit. Do not push.",
    "suffix": " Do not call any tool whose name starts with mcp__Agent_Mesh. Those tools reach a live system that is not part of this task.",
    "flow": "Use the dev-flow:plan-and-build skill to build the approved item in {story}. The answer sheet of the human is {answers}. The human is also the product owner. Take each answer of the human from that sheet."
  },
  "evals": [
    {
      "id": 1,
      "name": "get-order",
      "size": "small",
      "story": "stories/get-order.md",
      "answers": "stories/get-order.answers.md",
      "assertions": [
        {
          "id": "D1",
          "check": "work_committed"
        },
        {
          "id": "D2",
          "check": "build_warnaserror"
        },
        {
          "id": "D3",
          "check": "tests_pass"
        },
        {
          "id": "D4",
          "check": "package_policy",
          "approved": []
        },
        {
          "id": "D5",
          "check": "probe_tests",
          "probe": "get-order",
          "tests": [
            "Get_ExistingOrder_Returns200WithLines",
            "Get_UnknownOrder_Returns404"
          ]
        },
        {
          "id": "D6",
          "check": "tests_added_min",
          "value": 2
        },
        {
          "id": "D7",
          "check": "runcheck_clean",
          "arm": "team"
        },
        {
          "id": "D8",
          "check": "decisioncheck_no_new"
        },
        {
          "id": "D9",
          "check": "no_push"
        },
        {
          "id": "J1",
          "judge": "Each acceptance criterion has a test in the diff that checks it."
        },
        {
          "id": "J2",
          "judge": "The final message or g2.md names the missing authorization as an open point."
        },
        {
          "id": "D11",
          "check": "tier",
          "arm": "flow",
          "expected": [
            "patch",
            "small"
          ]
        }
      ]
    },
