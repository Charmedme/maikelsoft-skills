@@ -0,0 +1,36 @@
+namespace Orders.Api.Orders;
+
+public sealed class DiscountCodeItem
+{
+    private DiscountCodeItem()
+    {
+        Code = string.Empty;
+    }
+
+    public DiscountCodeItem(string code, int percent, DateOnly expiresOn, int maxUses)
+    {
+        Code = code;
+        Percent = percent;
+        ExpiresOn = expiresOn;
+        MaxUses = maxUses;
+    }
+
+    public string Code { get; private set; }
+
+    public int Percent { get; private set; }
+
+    public DateOnly ExpiresOn { get; private set; }
+
+    public int MaxUses { get; private set; }
+
+    public int Uses { get; private set; }
+
+    public void Replace(int percent, DateOnly expiresOn, int maxUses)
+    {
+        Percent = percent;
+        ExpiresOn = expiresOn;
+        MaxUses = maxUses;
+    }
+
+    public static string Normalize(string code) => code.Trim().ToUpperInvariant();
+}
