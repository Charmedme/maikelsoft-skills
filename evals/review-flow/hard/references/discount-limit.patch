+    private static async Task<Ok<DiscountCodeRequest>> PutCodeAsync(DiscountCodeRequest request, OrdersDbContext db, CancellationToken ct)
+    {
+        var key = DiscountCodeItem.Normalize(request.Code);
+        var item = await db.DiscountCodes.FindAsync([key], ct);
+        if (item is null)
+        {
+            db.DiscountCodes.Add(new DiscountCodeItem(key, request.Percent, request.ExpiresOn, request.MaxUses));
+        }
+        else
+        {
+            item.Replace(request.Percent, request.ExpiresOn, request.MaxUses);
+        }
+
+        await db.SaveChangesAsync(ct);
+        return TypedResults.Ok(request);
+    }
