+namespace Orders.Api.Orders;
+
+public sealed class OrderReturn
+{
+    private readonly List<ReturnedLine> _lines = [];
+
+    private OrderReturn()
+    {
+        IdempotencyKey = string.Empty;
+    }
+
+    public OrderReturn(Guid orderId, string idempotencyKey, decimal refund, DateTimeOffset occurredAt)
+    {
+        OrderId = orderId;
+        IdempotencyKey = idempotencyKey;
+        Refund = refund;
+        OccurredAt = occurredAt;
+    }
+
+    public Guid Id { get; private set; }
+
+    public Guid OrderId { get; private set; }
+
+    public string IdempotencyKey { get; private set; }
+
+    public decimal Refund { get; private set; }
+
+    public DateTimeOffset OccurredAt { get; private set; }
+
+    public IReadOnlyList<ReturnedLine> Lines => _lines;
+
+    public void Add(string sku, int quantity) => _lines.Add(new ReturnedLine(sku, quantity));
+}
+
+public sealed class ReturnedLine
+{
+    private ReturnedLine()
+    {
+        Sku = string.Empty;
+    }
+
+    public ReturnedLine(string sku, int quantity)
+    {
+        Sku = sku;
+        Quantity = quantity;
+    }
+
+    public int Id { get; private set; }
+
+    public string Sku { get; private set; }
+
+    public int Quantity { get; private set; }
+}
