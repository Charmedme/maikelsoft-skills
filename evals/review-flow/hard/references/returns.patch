+    private static async Task<Results<Ok<ReturnResponse>, NotFound, ProblemHttpResult>> ReturnAsync(
+        Guid id,
+        ReturnRequest request,
+        HttpRequest http,
+        OrdersDbContext db,
+        TimeProvider time,
+        CancellationToken ct)
+    {
+        string key = http.Headers["Idempotency-Key"].ToString();
+        if (key.Length == 0)
+        {
+            return TypedResults.Problem(title: "The Idempotency-Key header is required.", statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        await using var tx = await db.Database.BeginTransactionAsync(ct);
+        await db.Database.ExecuteSqlAsync($"SELECT 1 FROM orders WHERE \"Id\" = {id} FOR UPDATE", ct);
+        var order = await db.Orders.Include(order => order.Lines).FirstOrDefaultAsync(order => order.Id == id, ct);
+        if (order is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var earlier = await db.Returns.AsNoTracking().Include(item => item.Lines).Where(item => item.OrderId == id).ToListAsync(ct);
+        var same = earlier.FirstOrDefault(item => item.IdempotencyKey == key);
+        if (same is not null)
+        {
+            return TypedResults.Ok(new ReturnResponse(same.Refund));
+        }
+
+        var now = time.GetUtcNow();
+        if (order.Status != OrderStatus.Shipped || now - order.ShippedAt > TimeSpan.FromDays(14))
+        {
+            return TypedResults.Problem(title: "This order cannot be returned.", statusCode: StatusCodes.Status409Conflict);
+        }
+
+        var sum = 0m;
+        foreach (var part in request.Lines)
+        {
+            var line = order.Lines.FirstOrDefault(line => line.Sku == part.Sku);
+            var returned = earlier.SelectMany(item => item.Lines).Where(item => item.Sku == part.Sku).Sum(item => item.Quantity);
+            if (line is null || part.Quantity < 1 || returned + part.Quantity > line.Quantity)
+            {
+                return TypedResults.Problem(title: "This line cannot be returned.", statusCode: StatusCodes.Status409Conflict);
+            }
+
+            sum += part.Quantity * line.UnitPrice;
+        }
+
+        var refund = Math.Round(sum * 0.9m, 2, MidpointRounding.AwayFromZero);
+        var record = new OrderReturn(id, key, refund, now);
+        foreach (var part in request.Lines)
+        {
+            record.Add(part.Sku, part.Quantity);
+            var item = await db.Stock.FindAsync([part.Sku], ct);
+            item?.Release(part.Quantity);
+        }
+
+        db.Returns.Add(record);
+        db.Events.Add(new OrderEvent(id, "OrderReturned", now));
+        await db.SaveChangesAsync(ct);
+        await tx.CommitAsync(ct);
+        return TypedResults.Ok(new ReturnResponse(refund));
+    }
+
