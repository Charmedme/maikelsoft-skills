+    private static async Task<Results<Ok<OrderResponse>, NotFound, ProblemHttpResult>> CancelPartAsync(
+        Guid id,
+        string sku,
+        CancelPartRequest request,
+        OrdersDbContext db,
+        TimeProvider time,
+        IOptions<OrdersOptions> options,
+        CancellationToken ct)
+    {
+        if (request.Quantity < 1)
+        {
+            return TypedResults.Problem(title: "The quantity must be 1 or more.", statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        await using var tx = await db.Database.BeginTransactionAsync(ct);
+        await db.Database.ExecuteSqlAsync($"SELECT 1 FROM orders WHERE \"Id\" = {id} FOR UPDATE", ct);
+        var order = await db.Orders.Include(order => order.Lines).FirstOrDefaultAsync(order => order.Id == id, ct);
+        var line = order?.Lines.FirstOrDefault(line => line.Sku == sku);
+        if (order is null || line is null)
+        {
+            return TypedResults.NotFound();
+        }
+
+        var now = time.GetUtcNow();
+        if (order.Status != OrderStatus.Placed || now - order.PlacedAt > options.Value.CancelWindow || request.Quantity > line.Quantity)
+        {
+            return TypedResults.Problem(title: "This part cannot be cancelled.", statusCode: StatusCodes.Status409Conflict);
+        }
+
+        order.CancelPart(line, request.Quantity);
+        var item = await db.Stock.FindAsync([sku], ct);
+        item?.Release(request.Quantity);
+        db.Events.Add(new OrderEvent(order.Id, "OrderLineCancelled", now));
+        if (order.Lines.Count == 0)
+        {
+            order.Cancel(now, options.Value.CancelWindow);
+            db.Events.Add(new OrderEvent(order.Id, "OrderCancelled", now));
+        }
+
+        var result = await SaveAsync(order, db, ct);
+        await tx.CommitAsync(ct);
+        return result;
+    }
+
