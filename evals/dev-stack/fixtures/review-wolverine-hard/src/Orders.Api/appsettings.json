{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orders;Username=orders",
    "RabbitMq": "amqp://orders@rabbitmq.internal.example.com:5672/"
  },
  "Orders": {
    "MaxLinesPerOrder": 50,
    "CancelWindowHours": 24
  },
  "Payments": {
    "BaseUrl": "https://psp.example.com/",
    "Currency": "EUR",
    "TimeoutSeconds": 10
  },
  "Carrier": {
    "BaseUrl": "https://parcels.example.com/",
    "TimeoutSeconds": 15
  }
}
