{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orders;Username=orders"
  },
  "Orders": {
    "MaxLinesPerOrder": 50,
    "CancelWindowHours": 24
  },
  "Documents": {
    "CompanyName": "Example Shop B.V.",
    "CompanyAddress": "Havenstraat 12, 3011 AB Rotterdam",
    "LogoUrl": "https://cdn.example.com/logo.png",
    "MaxConcurrentPages": 4,
    "RenderTimeoutMs": 15000
  },
  "Payments": {
    "BaseUrl": "https://psp.example.com/",
    "Currency": "EUR",
    "TimeoutSeconds": 10
  }
}
