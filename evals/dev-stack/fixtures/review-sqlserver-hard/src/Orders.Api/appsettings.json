{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Server=localhost,1433;Database=Orders;Integrated Security=true;TrustServerCertificate=true;Application Name=orders-api"
  },
  "Orders": {
    "MaxLinesPerOrder": 50,
    "CancelWindowHours": 24
  },
  "Payments": {
    "BaseUrl": "https://psp.example.com/",
    "Currency": "EUR",
    "TimeoutSeconds": 10
  }
}
