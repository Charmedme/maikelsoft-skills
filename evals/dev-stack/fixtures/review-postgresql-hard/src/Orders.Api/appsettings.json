{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orders;Username=orders"
  },
  "Orders": {
    "MaxLinesPerOrder": 50,
    "CancelWindowHours": 24
  },
  "Picking": {
    "TimeoutMinutes": 120,
    "TimeoutJobEnabled": true
  },
  "Returns": {
    "WindowDays": 30,
    "ExpiryDays": 14,
    "ExpiryJobEnabled": true,
    "ExpiryJobIntervalMinutes": 60
  }
}
