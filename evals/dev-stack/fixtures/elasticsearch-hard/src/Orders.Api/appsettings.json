{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orders;Username=orders"
  },
  "Search": {
    "Uri": "https://search.internal.example.com:9200",
    "CertificateFingerprint": "",
    "RequestTimeoutSeconds": 10
  },
  "Orders": {
    "MaxLinesPerOrder": 50,
    "CancelWindowHours": 24
  },
  "Smtp": {
    "Host": "smtp.internal.example.com",
    "Port": 587,
    "Security": "StartTls",
    "UserName": "orders",
    "From": "orders@shop.example.com",
    "FromName": "Example Shop"
  },
  "Payments": {
    "BaseUrl": "https://psp.example.com/",
    "Currency": "EUR",
    "TimeoutSeconds": 10
  }
}
