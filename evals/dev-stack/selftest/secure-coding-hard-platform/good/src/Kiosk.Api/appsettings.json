{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kiosk": "Host=localhost;Port=5432;Database=kiosk;Username=kiosk"
  },
  "Database": {
    "Initialize": false
  },
  "Jwt": {
    "Issuer": "kiosk",
    "Audience": "kiosk-api",
    "SigningKey": "kiosk-test-only-jwt-signing-key-7c1e0a9f4b2d48e6a3f5",
    "LifetimeMinutes": 120
  },
  "Payments": {
    "Provider": "card-gateway",
    // Set with: dotnet user-secrets set "Payments:ProviderApiKey" "<key>"
    "ProviderApiKey": ""
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Files": {
    "InvoiceRoot": "App_Data/invoices",
    "UploadRoot": "wwwroot/uploads",
    "ProfileImageRoot": "wwwroot/profile-images",
    "PublicFilesRoot": "wwwroot/files",
    "AccessLogRoot": "logs/access"
  },
  "ProfileImages": {
    "AllowedHosts": [ "cdn.kiosk.example" ]
  },
  "Cors": {
    "AllowedOrigins": [ "https://shop.kiosk.example", "https://partners.kiosk.example" ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [ "10.20.0.5" ]
  },
  "Redirects": {
    "Allowed": [
      "https://github.com/kiosk-shop",
      "https://status.kiosk.example",
      "https://help.kiosk.example/articles"
    ]
  }
}
