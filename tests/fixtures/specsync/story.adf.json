            {
              "type": "text",
              "text": "As a customer, I want to return an order without cost, so that I can buy with less risk."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Behaviour spec",
