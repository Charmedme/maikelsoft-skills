                {
                  "type": "strong"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Feature: Free returns and guest checkout"
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": {
            "language": "gherkin"
          },
          "content": [
            {
              "type": "text",
              "text": "Rule: R1 Free return within 30 days (limit: 30 days)\n    Scenario: Return below the limit\n      Given an order that was delivered 29 days ago\n      When the customer returns the order\n      Then the shop charges “0.00” for the return\n    Scenario: Return at the limit\n      Given an order that was delivered 30 days ago\n      When the customer returns the order\n      Then the shop charges \"0.00\" for the return\n    Scenario: Return above the limit\n      Given an order that was delivered 31 days ago\n      When the customer returns the order\n      Then the shop charges a return fee of 4.95"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Rule:",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "type": "text",
              "text": " R2 Guest checkout"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scenario: Guest pays without an account"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Given a guest with 1 product in the cart"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "When the guest pays with a valid card"
